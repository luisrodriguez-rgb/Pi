---
import { MILESTONES } from '../../data/milestones';
import { type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const milestone = MILESTONES[4];
---

<section 
  id="scene-5" 
  class="scene" 
  data-scene="london" 
  data-year={milestone.year}
  data-pi-value={milestone.precisionValue}
  data-theme={milestone.theme}
  data-scene-title={milestone.title[locale]}
>
  <div class="stage layout-split">
    <!-- Left Column: Brutalist Typographic Compression Column -->
    <div class="symbol-left-col choreo-header">
      <div class="museum-plate">
        [ FIG. 05 // LONDRES, 1706 — SYNOPSIS PALMARIORUM — PÁGINA 263 ]
      </div>

      <div class="beat" data-beat="0.05-0.38">
        <span class="scene-kicker">05 // LONDRES, 1706 d.C. · WILLIAM JONES</span>
        <h2 class="scene-title">{milestone.title[locale]}</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'Durante cuatro milenios, el número no tuvo nombre. Los sabios lo llamaban con pesadas frases en latín: «La cantidad que, cuando el diámetro es 1, representa la circunferencia». Hasta que un profesor galés autodidacta abrió un libro y cambió la historia.'
            : 'For four thousand years, the number had no name. Sages denoted it with cumbersome Latin circumlocutions: «The quantity which, when diameter is 1, defines the circumference». Until a self-taught Welsh tutor opened a book and changed mathematics forever.'}
        </p>
      </div>

      <!-- Compression Arena: Latin prose collapsing into 280px Colossal Pi -->
      <div class="compression-arena choreo-artifact">
        <div class="latin-words" id="latin-stream">
          <span class="w">Quantitas</span>
          <span class="w">in</span>
          <span class="w">circulo</span>
          <span class="w">quae</span>
          <span class="w">cum</span>
          <span class="w">diametro</span>
          <span class="w">inscripta</span>
          <span class="w">peripheriam</span>
          <span class="w">definit</span>
        </div>

        <!-- Colossal 280px Ink Pi Glyph -->
        <div class="colossal-pi-box" id="pi-monolith">
          <span class="colossal-pi">π</span>
          <span class="pi-sub">PERIPHERIA · WILLIAM JONES 1706</span>
        </div>
      </div>

      <div class="beat beat-climax" data-beat="0.84-0.98">
        <blockquote class="symbol-quote">
          <p>«El lenguaje matemático del universo por fin encontró su glifo inmortal.»</p>
          <cite>— William Jones (1706) &amp; Leonhard Euler (1737)</cite>
        </blockquote>
      </div>
    </div>

    <!-- Right Column: Archival Facsimile of Page 263 -->
    <div class="facsimile-col choreo-metrics">
      <div class="archival-photo-card tilt-right">
        <img src="/images/05-jones-facsimile.jpg" alt="Facsímil de Synopsis Palmariorum Matheseos página 263 (1706)" loading="eager" />
        <div class="photo-caption">
          <span>SYNOPSIS PALMARIORUM · PÁG. 263</span>
          <span class="photo-badge">1706</span>
        </div>
      </div>

      <div class="facsimile-text-card blueprint-panel">
        <div class="facsimile-header">
          <span class="facsimile-badge">DEFINICIÓN HISTÓRICA ORIGINAL (1706)</span>
          <button type="button" id="toggle-collapse-btn" class="collapse-btn">
            <span class="btn-indicator"></span>
            <span id="collapse-btn-label">SIMULAR COMPRESIÓN (68 LETRAS → 1 GLIFO)</span>
          </button>
        </div>
        <p class="facsimile-extract">
          «...There are various other ways of approximating the Ratio of the Diameter to the Circumference; one of the most remarkable is that by the celebrated Series... = 3.14159 &amp;c. = <strong>π</strong>»
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const latinStream = document.getElementById('latin-stream');
  const piMonolith = document.getElementById('pi-monolith');
  const toggleBtn = document.getElementById('toggle-collapse-btn');
  const btnLabel = document.getElementById('collapse-btn-label');
  const scene = document.getElementById('scene-5');

  let isCollapsed = false;

  function updateCollapseState(collapsed: boolean) {
    isCollapsed = collapsed;
    latinStream?.classList.toggle('is-compressed', collapsed);
    piMonolith?.classList.toggle('is-revealed', collapsed);
    if (btnLabel) {
      btnLabel.textContent = collapsed 
        ? 'EXPANDIR A FRASE EN LATÍN (68 LETRAS)' 
        : 'SIMULAR COMPRESIÓN (68 LETRAS → 1 GLIFO)';
    }
  }

  toggleBtn?.addEventListener('click', () => {
    updateCollapseState(!isCollapsed);
  });

  if (scene) {
    window.addEventListener('scroll', () => {
      const p = parseFloat(getComputedStyle(scene).getPropertyValue('--p')) || 0;
      // Smooth automatic transition when scrolling through beats 2 and 3
      if (p > 0.38 && !isCollapsed) {
        updateCollapseState(true);
      } else if (p < 0.25 && isCollapsed) {
        updateCollapseState(false);
      }
    }, { passive: true });
  }
</script>

<style>
  .scene {
    height: 380vh;
    position: relative;
    --p: 0;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    background: #f5f2eb !important;
    color: #111111 !important;
  }

  .symbol-left-col {
    position: relative;
    width: 100%;
    max-width: 580px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .symbol-left-col .museum-plate {
    background: rgba(255, 255, 255, 0.88);
    color: #374151;
    border-color: rgba(17, 17, 17, 0.16);
    margin-bottom: 8px;
  }

  .scene-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: #b91c1c;
    display: inline-block;
    margin-bottom: 4px;
    font-weight: 700;
  }

  .scene-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    font-weight: 600;
    font-style: normal;
    color: #111111;
    margin: 0 0 8px;
    line-height: 1.15;
  }

  .beat-text {
    font-family: var(--font-editorial);
    font-size: clamp(0.95rem, 1.7vw, 1.08rem);
    color: #262626;
    line-height: 1.65;
    margin: 0;
  }

  .symbol-quote {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.7rem);
    font-style: italic;
    color: #b91c1c;
    line-height: 1.45;
    margin: 0;
  }

  .symbol-quote cite {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-style: normal;
    color: #6b7280;
    margin-top: 8px;
    letter-spacing: 0.08em;
  }

  /* Compression Arena: Latin words collapsing to Colossal Pi */
  .compression-arena {
    position: relative;
    width: 100%;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 16px 0;
  }

  .latin-words {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 18px;
    max-width: 540px;
    padding: 10px;
    transition: all 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .latin-words.is-compressed {
    transform: scale(0.55);
    opacity: 0.04;
    filter: blur(5px);
    pointer-events: none;
  }

  .w {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    font-style: italic;
    color: #2d3748;
    letter-spacing: 0.04em;
    transition: color 0.3s ease;
  }

  /* Colossal 280px Black Ink Pi Glyph */
  .colossal-pi-box {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transform: scale(0.3);
    opacity: 0;
    pointer-events: none;
    transition: all 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .colossal-pi-box.is-revealed {
    transform: scale(1);
    opacity: 1;
    pointer-events: auto;
  }

  .colossal-pi {
    font-family: var(--font-display);
    font-size: clamp(140px, 18vw, 280px);
    font-weight: 700;
    color: #111111;
    line-height: 0.85;
    text-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .pi-sub {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: #6b7280;
    margin-top: 8px;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* Right Column: Facsimile Presentation */
  .facsimile-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    width: 100%;
    max-width: 520px;
  }

  .facsimile-text-card {
    width: 100%;
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.95) !important;
    border: 1px solid rgba(17, 17, 17, 0.18) !important;
    color: #111111 !important;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .facsimile-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    border-bottom: 1px solid rgba(17, 17, 17, 0.1);
    padding-bottom: 8px;
  }

  .facsimile-badge {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    color: #b91c1c;
    font-weight: 700;
  }

  .collapse-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #111111;
    border: 1px solid #111111;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    padding: 5px 12px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .collapse-btn:hover {
    background: #b91c1c;
    border-color: #b91c1c;
  }

  .btn-indicator {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ff5555;
  }

  .facsimile-extract {
    font-family: var(--font-editorial);
    font-size: 0.94rem;
    font-style: italic;
    color: #374151;
    line-height: 1.55;
    margin: 0;
  }

  .facsimile-extract strong {
    color: #111111;
    font-size: 1.15rem;
    font-family: var(--font-display);
    font-weight: 700;
  }
</style>
