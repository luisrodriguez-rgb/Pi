---
import { MILESTONES } from '../../data/milestones';
import { type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const milestone = MILESTONES[4];
---

<section 
  id="scene-5" 
  class="scene" 
  data-scene="london" 
  data-year={milestone.year}
  data-pi-value={milestone.precisionValue}
  data-theme={milestone.theme}
  data-scene-title={milestone.title[locale]}
>
  <div class="stage">
    <!-- Narrative Header (In-flow, balanced typography, zero collision with catalog plate) -->
    <div class="narrative">
      <div class="beat" data-beat="0.05-0.38">
        <span class="scene-kicker">05 // LONDRES, 1706 d.C. · WILLIAM JONES</span>
        <h2 class="scene-title">{milestone.title[locale]}</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'Durante cuatro milenios, el número no tuvo nombre. Los sabios lo llamaban con pesadas frases en latín: «La cantidad que, cuando el diámetro es 1, representa la circunferencia». Hasta que un profesor galés autodidacta abrió un libro y cambió la historia.'
            : 'For four thousand years, the number had no name. Sages denoted it with cumbersome Latin circumlocutions: «The quantity which, when diameter is 1, defines the circumference». Until a self-taught Welsh tutor opened a book and changed mathematics forever.'}
        </p>
      </div>

      <div class="beat" data-beat="0.42-0.80">
        <span class="scene-kicker">05 // EL COLAPSO TIPOGRÁFICO</span>
        <h2 class="scene-title">De Nueve Palabras a una Letra</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'En la página 263 de su obra Synopsis Palmariorum Matheseos, William Jones imprimió por primera vez la letra griega π (por "periferia"). Tres décadas después, Leonhard Euler la adoptó, convirtiéndola en el símbolo universal del cosmos.'
            : 'Upon page 263 of his Synopsis Palmariorum Matheseos, William Jones set into metal type the Greek letter π (for "periphery"). Three decades later, Leonhard Euler championed it, crystallizing it as the cosmos’s universal glyph.'}
        </p>
      </div>

      <div class="beat beat-climax" data-beat="0.84-0.98">
        <blockquote class="symbol-quote">
          <p>«El lenguaje matemático del universo por fin encontró su glifo inmortal.»</p>
          <cite>— William Jones (1706) &amp; Leonhard Euler (1737)</cite>
        </blockquote>
      </div>
    </div>

    <!-- Symbol Transformation Stage (Positioned below narrative, zero empty void) -->
    <div class="symbol-stage" id="symbol-stage">
      <!-- Museum Catalog Technical Plate (In-Flow) -->
      <div class="museum-plate">
        [ FIG. 05 // LONDRES, 1706 — SYNOPSIS PALMARIORUM — PÁGINA 263 ]
      </div>

      <!-- Historical Facsimile and Compression Laboratory -->
      <div class="symbol-display blueprint-panel">
        <!-- Interactive Latin Circumlocution to Pi Compressor -->
        <div class="compression-rig">
          <div class="latin-words" id="latin-stream">
            <span class="w w-1">Quantitas</span>
            <span class="w w-2">in</span>
            <span class="w w-3">circulo</span>
            <span class="w w-4">quae</span>
            <span class="w w-5">cum</span>
            <span class="w w-6">diametro</span>
            <span class="w w-7">inscripta</span>
            <span class="w w-8">peripheriam</span>
            <span class="w w-9">definit</span>
          </div>

          <!-- The Illuminated Pi Glyph -->
          <div class="pi-monolith" id="pi-monolith">
            <span class="pi-greek-char">π</span>
            <span class="pi-sub">PERIPHERIA · 1706</span>
          </div>
        </div>

        <!-- William Jones 1706 Original Facsimile Card (Zero SaaS Border-Radius) -->
        <div class="jones-facsimile">
          <div class="facsimile-header">
            <span class="facsimile-badge">SYNOPSIS PALMARIORUM MATHESEOS · PÁGINA 263</span>
            <button type="button" id="toggle-collapse-btn" class="collapse-btn">
              <span class="btn-indicator"></span>
              <span id="collapse-btn-label">SIMULAR COMPRESIÓN (68 LETRAS → 1 SÍMBOLO)</span>
            </button>
          </div>
          <p class="facsimile-extract">
            «...There are various other ways of approximating the Ratio of the Diameter to the Circumference; one of the most remarkable is that by the celebrated Series... = 3.14159 &amp;c. = <strong>π</strong>»
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const symbolStage = document.getElementById('symbol-stage');
  const latinStream = document.getElementById('latin-stream');
  const piMonolith = document.getElementById('pi-monolith');
  const toggleBtn = document.getElementById('toggle-collapse-btn');
  const btnLabel = document.getElementById('collapse-btn-label');

  let isCollapsed = false;

  function updateCollapseState(collapsed: boolean) {
    isCollapsed = collapsed;
    latinStream?.classList.toggle('is-compressed', collapsed);
    piMonolith?.classList.toggle('is-revealed', collapsed);
    if (btnLabel) {
      btnLabel.textContent = collapsed 
        ? 'EXPANDIR A FRASE EN LATÍN (68 LETRAS)' 
        : 'SIMULAR COMPRESIÓN (68 LETRAS → 1 SÍMBOLO)';
    }
  }

  toggleBtn?.addEventListener('click', () => {
    updateCollapseState(!isCollapsed);
  });

  if (symbolStage) {
    const scene = symbolStage.closest('[data-scene]') as HTMLElement | null;
    window.addEventListener('scroll', () => {
      if (!scene) return;
      const p = parseFloat(getComputedStyle(scene).getPropertyValue('--p')) || 0;
      // Smooth automatic transition when scrolling through beats 2 and 3
      if (p > 0.42 && !isCollapsed) {
        updateCollapseState(true);
      } else if (p < 0.28 && isCollapsed) {
        updateCollapseState(false);
      }
    }, { passive: true });
  }
</script>

<style>
  .scene {
    height: 380vh;
    position: relative;
    --p: 0;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    background: radial-gradient(circle at 50% 50%, #171513 0%, #080706 100%);
    padding: calc(var(--hud-height, 68px) + 12px) 20px 16px;
    box-sizing: border-box;
    gap: 10px;
  }

  /* Uncollapsible In-Flow Narrative Box */
  .narrative {
    position: relative;
    width: 100% !important;
    max-width: min(90vw, 740px) !important;
    min-height: 120px;
    margin: 0 auto !important;
    text-align: center !important;
    pointer-events: none;
    z-index: 5;
    flex-shrink: 0;
  }

  .scene-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: #c59b27;
    display: inline-block;
    margin-bottom: 4px;
  }

  .scene-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 400;
    font-style: italic;
    color: #fff;
    margin: 0 0 8px;
    filter: url(#ink-displacement);
  }

  .beat-text {
    font-family: var(--font-editorial);
    font-size: clamp(0.92rem, 1.7vw, 1.05rem);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    margin: 0;
  }

  .symbol-quote {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.5vw, 1.7rem);
    font-style: italic;
    color: #c59b27;
    line-height: 1.45;
    margin: 0;
  }

  .symbol-quote cite {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-style: normal;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 8px;
    letter-spacing: 0.05em;
  }

  /* Symbol Transformation Stage */
  .symbol-stage {
    position: relative;
    width: 100%;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 2px;
    z-index: 2;
  }

  .symbol-display {
    width: 100%;
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    background: rgba(18, 16, 14, 0.95) !important;
    border: 1px solid rgba(197, 155, 39, 0.35) !important;
  }

  .compression-rig {
    position: relative;
    width: 100%;
    min-height: 130px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .latin-words {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 18px;
    max-width: 640px;
    padding: 10px;
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .latin-words.is-compressed {
    transform: scale(0.6);
    opacity: 0.12;
    filter: blur(4px);
    pointer-events: none;
  }

  .w {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    font-style: italic;
    color: rgba(212, 175, 55, 0.75);
    letter-spacing: 0.04em;
    transition: color 0.3s ease;
  }

  /* Giant Pi Monolith */
  .pi-monolith {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transform: scale(0.3);
    opacity: 0;
    pointer-events: none;
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pi-monolith.is-revealed {
    transform: scale(1);
    opacity: 1;
    pointer-events: auto;
  }

  .pi-greek-char {
    font-family: var(--font-display);
    font-size: clamp(5.5rem, 12vw, 8rem);
    font-weight: 700;
    color: #c59b27;
    line-height: 1;
    text-shadow: 
      0 0 30px rgba(197, 155, 39, 0.5),
      0 0 60px rgba(197, 155, 39, 0.2);
  }

  .pi-sub {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--muted);
    margin-top: 4px;
  }

  /* Facsimile Plate */
  .jones-facsimile {
    width: 100%;
    padding: 14px 18px;
    border-top: 1px solid var(--grid-line);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .facsimile-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .facsimile-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: #c59b27;
  }

  .collapse-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: 1px solid rgba(197, 155, 39, 0.4);
    color: #ede8dc;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .collapse-btn:hover {
    border-color: #c59b27;
    background: rgba(197, 155, 39, 0.15);
    color: #c59b27;
  }

  .btn-indicator {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #c59b27;
  }

  .facsimile-extract {
    font-family: var(--font-editorial);
    font-size: 0.92rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.5;
    margin: 0;
  }

  .facsimile-extract strong {
    color: #c59b27;
    font-size: 1.1rem;
    font-family: var(--font-display);
  }

  @media (max-height: 750px) {
    .compression-rig {
      min-height: 100px;
    }
    .pi-greek-char {
      font-size: 4.5rem;
    }
  }
</style>
