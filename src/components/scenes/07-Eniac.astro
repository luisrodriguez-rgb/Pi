---
import { MILESTONES } from '../../data/milestones';
import PunchCard from '../PunchCard.astro';
import { type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const milestone = MILESTONES[6];
---

<section 
  id="scene-7" 
  class="scene" 
  data-scene="eniac" 
  data-year={milestone.year}
  data-pi-value={milestone.piApproximation}
  data-theme={milestone.theme}
  data-scene-title={milestone.title[locale]}
>
  <div class="stage">
    <!-- Narrative beats -->
    <div class="narrative">
      <div class="beat" data-beat="0.05-0.38">
        <span class="scene-kicker">07 // MARYLAND, 1949 d.C.</span>
        <h2 class="scene-title">{milestone.title[locale]}</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'En el Laboratorio Balístico de Aberdeen, un monstruo militar de 30 toneladas con 17,468 tubos de vacío fue reprogramado para un objetivo pacífico: desatar la fórmula de Machin sobre el infinito.'
            : 'At the Aberdeen Ballistics Research Lab, a 30-ton military colossus with 17,468 vacuum tubes was reprogrammed for a peaceful pursuit: unleashing Machin’s formula upon infinity.'}
        </p>
      </div>

      <div class="beat" data-beat="0.42-0.95">
        <span class="scene-kicker">07 // 70 HORAS DE FUEGO Y SILICIO</span>
        <h2 class="scene-title">2,037 Decimales Perforados</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'Durante el fin de semana del 4 de julio de 1949, ENIAC funcionó ininterrumpidamente durante 70 horas. Las tarjetas de 80 columnas perforaron 2,037 decimales exactos, pulverizando 4,000 años de cálculo manual.'
            : 'Over the July 4th weekend in 1949, ENIAC ran nonstop for 70 hours. The 80-column Hollerith cards punched out 2,037 exact decimals, pulverizing 4,000 years of manual arithmetic.'}
        </p>
      </div>
    </div>

    <!-- The PunchCard Assembly -->
    <div class="card-stage">
      <PunchCard />
    </div>
  </div>
</section>

<style>
  .scene {
    height: 380vh;
    position: relative;
    --p: 0;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: radial-gradient(circle at 50% 50%, #1c1810 0%, #0c0a07 100%);
    padding: 0 20px;
  }

  .narrative {
    position: absolute;
    top: 10vh;
    max-width: 680px;
    text-align: center;
    pointer-events: none;
    z-index: 5;
  }

  .beat {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
  }

  .beat.is-active {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    pointer-events: auto;
  }

  .scene-kicker {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: #ffb000;
    display: inline-block;
    margin-bottom: 6px;
  }

  .scene-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 400;
    color: #fff;
    margin: 0 0 10px;
  }

  .beat-text {
    font-family: var(--font-sans);
    font-size: clamp(0.9rem, 1.6vw, 1.05rem);
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.5;
    margin: 0;
  }

  .card-stage {
    position: relative;
    margin-top: 18vh;
    width: 100%;
    display: flex;
    justify-content: center;
    z-index: 2;
  }
</style>
