---
import { MILESTONES } from '../../data/milestones';
import { type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const milestone = MILESTONES[2];
---

<section 
  id="scene-3" 
  class="scene" 
  data-scene="china" 
  data-year={milestone.year}
  data-pi-value={milestone.precisionValue}
  data-theme={milestone.theme}
  data-scene-title={milestone.title[locale]}
>
  <div class="stage">
    <!-- Bamboo Rods & Silk Ink Texture Backdrop -->
    <div class="china-backdrop">
      <div class="bamboo-matrix" id="bamboo-matrix">
        <!-- 30 visual counting rods that reorient with scroll -->
        {Array.from({ length: 28 }).map((_, i) => (
          <div class="bamboo-rod" style={`--i: ${i};`}></div>
        ))}
      </div>
    </div>

    <!-- Narrative Center (Uncollapsible, beautiful text flow) -->
    <div class="narrative">
      <div class="beat" data-beat="0.05-0.38">
        <span class="scene-kicker">03 // JIANKANG, 480 d.C. · CHINA</span>
        <h2 class="scene-title">{milestone.title[locale]}</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'Mientras Europa se sumía en las sombras tras la caída de Roma, el astrónomo chino Zu Chongzhi y su hijo se encerraron durante años en una habitación con miles de varillas de bambú y hueso (su chóu) esparcidas por el suelo. Si cometían un solo error al mover una varilla, debían reiniciar meses de cálculo.'
            : 'As Europe plunged into shadow after Rome’s fall, Chinese astronomer Zu Chongzhi and his son locked themselves away with thousands of bamboo and bone rods (su chóu) spread across the floor. If a single stick slipped, months of agonizing computation had to restart from scratch.'}
        </p>
      </div>

      <div class="beat" data-beat="0.42-0.80">
        <span class="scene-kicker">03 // LA FRACCIÓN MILÜ (355/113)</span>
        <h2 class="scene-title">24,576 Lados en el Suelo</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'Duplicaron los lados del polígono hasta alcanzar la asombrosa cifra de 24,576 caras. Al hacer zoom extremo al borde, cada faceta es tan microscópica que el ojo humano no puede distinguirla de una circunferencia perfecta.'
            : 'They doubled the polygon sides until reaching an astonishing 24,576 facets. Magnifying its rim reveals edges so infinitesimal the human eye cannot distinguish them from a true mathematical circle.'}
        </p>
      </div>

      <div class="beat beat-climax" data-beat="0.84-0.98">
        <blockquote class="milu-quote">
          <p>«355 / 113 = 3.1415929... Un récord de precisión que nadie en la Tierra logró superar durante ochocientos años.»</p>
          <cite>— Zu Chongzhi (Libro de Song)</cite>
        </blockquote>
      </div>
    </div>

    <!-- The 24,576-Sided Rim Zoom and Milü Fraction Card -->
    <div class="milu-rig">
      <div class="milu-card">
        <span class="milu-label">FRACCIÓN SAGRADA MILÜ (密率)</span>
        <div class="milu-fraction">
          <span class="m-num">355</span>
          <span class="m-line"></span>
          <span class="m-den">113</span>
        </div>
        <div class="milu-decimal">
          <span>=</span> <strong>3.14159292...</strong>
        </div>
        <span class="milu-accuracy">¡7 decimales exactos en el siglo V!</span>
      </div>

      <!-- Microscopic Facets Visualizer -->
      <div class="facets-microscope">
        <svg viewBox="0 0 400 120" class="facets-svg">
          <path d="M 0,60 Q 200,58 400,60" fill="none" stroke="#2a9d8f" stroke-width="3" stroke-dasharray="1.5,1.5"/>
          <text x="200" y="95" font-family="'JetBrains Mono', monospace" font-size="11" fill="rgba(42,157,143,0.8)" text-anchor="middle">
            FACETAS DE 24,576 LADOS (LONGITUD &lt; 0.0001R)
          </text>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .scene {
    height: 380vh;
    position: relative;
    --p: 0;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: radial-gradient(circle at 50% 50%, #151b18 0%, #070908 100%);
    padding: 0 20px;
  }

  .china-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  /* Matrix of bamboo calculating rods */
  .bamboo-matrix {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 18px;
    padding: 40px;
    opacity: 0.18;
  }

  .bamboo-rod {
    width: 4px;
    height: 48px;
    background: linear-gradient(180deg, #d4a373 0%, #8d6b4f 100%);
    border-radius: 2px;
    transform: rotate(calc(var(--p) * 180deg + var(--i) * 15deg));
    transition: transform 0.2s ease;
  }

  /* Uncollapsible Narrative Box */
  .narrative {
    position: absolute;
    top: 10vh;
    width: 100% !important;
    max-width: min(90vw, 740px) !important;
    margin: 0 auto !important;
    text-align: center !important;
    pointer-events: none;
    z-index: 5;
  }

  .beat {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    width: 100% !important;
  }

  .beat.is-active {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    pointer-events: auto;
  }

  .scene-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: #2a9d8f;
    display: inline-block;
    margin-bottom: 6px;
  }

  .scene-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.8vw, 2.8rem);
    font-weight: 400;
    color: #fff;
    margin: 0 0 10px;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.9);
  }

  .beat-text {
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.8vw, 1.12rem);
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.65;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
  }

  .milu-quote {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.8vw, 1.9rem);
    font-style: italic;
    color: #e76f51;
    line-height: 1.5;
    margin: 0;
    text-shadow: 0 0 25px rgba(231, 111, 81, 0.4);
  }

  .milu-quote cite {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-style: normal;
    color: #2a9d8f;
    margin-top: 10px;
    letter-spacing: 0.08em;
  }

  .milu-rig {
    margin-top: 18vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    z-index: 2;
  }

  .milu-card {
    background: rgba(15, 27, 24, 0.85);
    border: 1px solid rgba(42, 157, 143, 0.35);
    border-radius: 16px;
    padding: 24px 36px;
    backdrop-filter: blur(14px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8), inset 0 0 20px rgba(42, 157, 143, 0.1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .milu-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.1em;
  }

  .milu-fraction {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 2.2rem;
    font-weight: 700;
    color: #e76f51;
    line-height: 1;
  }

  .m-line {
    width: 100%;
    height: 3px;
    background: #2a9d8f;
    margin: 4px 0;
    border-radius: 2px;
  }

  .milu-decimal {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 1.3rem;
    color: #fdfaf7;
  }

  .milu-decimal strong {
    color: #2a9d8f;
    text-shadow: 0 0 10px rgba(42, 157, 143, 0.5);
  }

  .milu-accuracy {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #ffd700;
  }

  .facets-microscope {
    width: min(85vw, 480px);
    height: 70px;
  }

  .facets-svg {
    width: 100%;
    height: 100%;
  }
</style>
