---
import { MILESTONES } from '../../data/milestones';
import { type Locale } from '../../i18n';
import BambooRods from '../BambooRods.astro';
import SceneVideo from '../SceneVideo.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const milestone = MILESTONES[2];
---

<section 
  id="scene-3" 
  class="scene" 
  data-scene="china" 
  data-year={milestone.year}
  data-pi-value={milestone.precisionValue}
  data-theme={milestone.theme}
  data-scene-title={milestone.title[locale]}
>
  <div class="stage">
    <!-- Atmospheric Video Background with Paper Blend -->
    <SceneVideo 
      src="/videos/03-bamboo.mp4" 
      poster="/images/03-bamboo.jpg" 
      blend="luminosity" 
      opacity={0.35} 
    />

    <!-- Inner Content: Zigzag / Editorial Asymmetric Layout -->
    <div class="stage-content layout-zigzag">
      <!-- Left Column: Giant Editorial Narrative & Archival Photo Card -->
      <div class="editorial-col choreo-header">
        <div class="narrative-layer">
          <div class="beat beat-1" data-beat="0.00-0.40">
            <span class="scene-kicker">03 // JIANKANG, 480 d.C. · DINASTÍA LIU SONG</span>
            <h2 class="scene-title">{milestone.title[locale]}</h2>

            <!-- Archival Photo Card: Varillas Su Chóu y Matemáticos Han -->
            <div class="archival-photo-card tilt-left" style="margin: 14px 0 16px 0;">
              <img src="/images/03-bamboo.jpg" alt="Varillas de bambú Su Chóu y tratados chinos" loading="eager" />
              <div class="photo-caption">
                <span>SU CHÓU · VARILLAS DE BAMBÚ Y HUESO</span>
                <span class="photo-badge">480 d.C.</span>
              </div>
            </div>

            <p class="beat-text">
              {locale === 'es'
                ? 'Mientras Europa se sumía en las sombras tras la caída de Roma, el astrónomo chino Zu Chongzhi y su hijo se encerraron durante años en una habitación con miles de varillas de bambú y hueso (su chóu) esparcidas por el suelo. Si cometían un solo error al mover una varilla, debían reiniciar meses de cálculo.'
                : 'As Europe plunged into shadow after Rome’s fall, Chinese astronomer Zu Chongzhi and his son locked themselves away with thousands of bamboo and bone rods (su chóu) spread across the floor. If a single stick slipped, months of agonizing computation had to restart from scratch.'}
            </p>
          </div>

          <div class="beat beat-2" data-beat="0.38-0.78">
            <span class="scene-kicker">03 // LA FRACCIÓN MILÜ (355/113)</span>
            <h2 class="scene-title">24,576 Lados en el Suelo</h2>
            <p class="beat-text">
              {locale === 'es'
                ? 'Duplicaron los lados del polígono hasta alcanzar la asombrosa cifra de 24,576 caras. Al hacer zoom extremo al borde, cada faceta es tan microscópica que el ojo humano no puede distinguirla de una circunferencia perfecta.'
                : 'They doubled the polygon sides until reaching an astonishing 24,576 facets. Magnifying its rim reveals edges so infinitesimal the human eye cannot distinguish them from a true mathematical circle.'}
            </p>
          </div>

          <div class="beat beat-climax" data-beat="0.75-1.00">
            <blockquote class="milu-quote">
              <p>«355 / 113 = 3.1415929... Un récord de precisión que nadie en la Tierra logró superar durante ochocientos años.»</p>
              <cite>— Zu Chongzhi (Libro de Song)</cite>
            </blockquote>
          </div>
        </div>
      </div>

      <!-- Right Column: Su Chóu Bamboo Rods Rig & Sacred Milü Breakdown -->
      <div class="china-rig choreo-artifact">
        <!-- Museum Catalog Technical Plate -->
        <div class="museum-plate">
          [ FIG. 03 // JIANKANG, 480 d.C. — SU CHÓU (VARILLAS DE BAMBÚ) — PRECISIÓN: 10⁻⁷ ]
        </div>

        <!-- Live Suànchóu Ancient Rod Visualizer -->
        <BambooRods />

        <!-- Architectural Technical Breakdown Panel -->
        <div class="math-panel blueprint-panel choreo-metrics">
          <div class="math-col">
            <span class="col-title">FRACCIÓN SAGRADA MILÜ (密率)</span>
            <span class="col-formula tabular">355 / 113</span>
            <strong class="col-val tabular" style="color: #b91c1c;">355 / 113</strong>
          </div>

          <div class="math-divider"></div>

          <div class="math-col">
            <span class="col-title">VALOR DECIMAL OBTENIDO</span>
            <span class="col-formula tabular">7 cifras exactas</span>
            <strong class="col-val col-accent tabular" style="color: #b91c1c;">3.14159292...</strong>
          </div>

          <div class="math-divider"></div>

          <div class="math-col">
            <span class="col-title">FACETAS DEL POLÍGONO</span>
            <span class="col-formula tabular">n = 24,576</span>
            <strong class="col-val tabular">Error &lt; 0.0000003</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .scene {
    height: 380vh;
    position: relative;
    --p: 0;
  }

  .stage {
    background: #f4efe6 !important;
    color: #1c1917 !important;
  }

  .editorial-col {
    position: relative;
    width: 100%;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .scene-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: #b91c1c;
    display: inline-block;
    margin-bottom: 6px;
    font-weight: 700;
  }

  .scene-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    font-weight: 600;
    font-style: normal;
    color: #1c1917;
    margin: 0 0 10px;
    line-height: 1.15;
  }

  .beat-text {
    font-family: var(--font-editorial);
    font-size: clamp(0.95rem, 1.7vw, 1.08rem);
    color: #292524;
    line-height: 1.65;
    margin: 0;
  }

  .milu-quote {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.7rem);
    font-style: italic;
    color: #b91c1c;
    line-height: 1.45;
    margin: 0;
  }

  .milu-quote cite {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-style: normal;
    color: #78716c;
    margin-top: 8px;
    letter-spacing: 0.08em;
  }

  /* China Rig Architecture */
  .china-rig {
    width: 100%;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    z-index: 2;
  }

  .china-rig .museum-plate {
    background: rgba(255, 255, 255, 0.85);
    color: #44403c;
    border-color: rgba(28, 25, 23, 0.15);
  }

  .china-rig .blueprint-panel {
    background: rgba(255, 255, 255, 0.9) !important;
    border-color: rgba(28, 25, 23, 0.18) !important;
    color: #1c1917 !important;
  }

  .math-panel {
    display: flex;
    align-items: center;
    justify-content: space-around;
    width: 100%;
    padding: 16px 20px;
    box-sizing: border-box;
  }

  .math-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2px;
    flex: 1;
  }

  .col-title {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: #78716c;
    text-transform: uppercase;
  }

  .col-formula {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: #57534e;
  }

  .col-val {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    color: #1c1917;
    margin-top: 2px;
  }

  .col-accent {
    color: #b91c1c;
  }

  .math-divider {
    width: 1px;
    height: 38px;
    background: rgba(28, 25, 23, 0.15);
  }
</style>
