---
import { MILESTONES } from '../../data/milestones';
import { type Locale } from '../../i18n';
import BambooRods from '../BambooRods.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const milestone = MILESTONES[2];
---

<section 
  id="scene-3" 
  class="scene" 
  data-scene="china" 
  data-year={milestone.year}
  data-pi-value={milestone.precisionValue}
  data-theme={milestone.theme}
  data-scene-title={milestone.title[locale]}
>
  <div class="stage">
    <!-- Narrative Header (Positioned cleanly above the Chinese calculation rig) -->
    <div class="narrative">
      <div class="beat" data-beat="0.05-0.38">
        <span class="scene-kicker">03 // JIANKANG, 480 d.C. · CHINA</span>
        <h2 class="scene-title">{milestone.title[locale]}</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'Mientras Europa se sumía en las sombras tras la caída de Roma, el astrónomo chino Zu Chongzhi y su hijo se encerraron durante años en una habitación con miles de varillas de bambú y hueso (su chóu) esparcidas por el suelo. Si cometían un solo error al mover una varilla, debían reiniciar meses de cálculo.'
            : 'As Europe plunged into shadow after Rome’s fall, Chinese astronomer Zu Chongzhi and his son locked themselves away with thousands of bamboo and bone rods (su chóu) spread across the floor. If a single stick slipped, months of agonizing computation had to restart from scratch.'}
        </p>
      </div>

      <div class="beat" data-beat="0.42-0.80">
        <span class="scene-kicker">03 // LA FRACCIÓN MILÜ (355/113)</span>
        <h2 class="scene-title">24,576 Lados en el Suelo</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'Duplicaron los lados del polígono hasta alcanzar la asombrosa cifra de 24,576 caras. Al hacer zoom extremo al borde, cada faceta es tan microscópica que el ojo humano no puede distinguirla de una circunferencia perfecta.'
            : 'They doubled the polygon sides until reaching an astonishing 24,576 facets. Magnifying its rim reveals edges so infinitesimal the human eye cannot distinguish them from a true mathematical circle.'}
        </p>
      </div>

      <div class="beat beat-climax" data-beat="0.84-0.98">
        <blockquote class="milu-quote">
          <p>«355 / 113 = 3.1415929... Un récord de precisión que nadie en la Tierra logró superar durante ochocientos años.»</p>
          <cite>— Zu Chongzhi (Libro de Song)</cite>
        </blockquote>
      </div>
    </div>

    <!-- Archimedes Gold Standard Technical Panel (Zero SaaS border-radius) -->
    <div class="china-rig">
      <!-- Museum Catalog Technical Plate -->
      <div class="museum-plate">
        [ FIG. 03 // JIANKANG, 480 d.C. — SU CHÓU (VARILLAS DE BAMBÚ) — PRECISIÓN: 10⁻⁷ ]
      </div>

      <!-- Live Suànchóu Ancient Rod Visualizer -->
      <BambooRods />

      <!-- Architectural Technical Breakdown Panel -->
      <div class="math-panel blueprint-panel">
        <div class="math-col">
          <span class="col-title">FRACCIÓN SAGRADA MILÜ (密率)</span>
          <span class="col-formula tabular">355 / 113</span>
          <strong class="col-val tabular">355 / 113</strong>
        </div>

        <div class="math-divider"></div>

        <div class="math-col">
          <span class="col-title">VALOR DECIMAL OBTENIDO</span>
          <span class="col-formula tabular">7 cifras exactas</span>
          <strong class="col-val col-accent tabular">3.14159292...</strong>
        </div>

        <div class="math-divider"></div>

        <div class="math-col">
          <span class="col-title">FACETAS DEL POLÍGONO</span>
          <span class="col-formula tabular">n = 24,576</span>
          <strong class="col-val tabular">Error &lt; 0.0000003</strong>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .scene {
    height: 380vh;
    position: relative;
    --p: 0;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    background: radial-gradient(circle at 50% 50%, #151b18 0%, #070908 100%);
    padding: calc(var(--hud-height, 68px) + 12px) 20px 16px;
    box-sizing: border-box;
    gap: 10px;
  }

  /* Uncollapsible Narrative Box */
  .narrative {
    position: relative;
    width: 100% !important;
    max-width: min(90vw, 740px) !important;
    min-height: 120px;
    margin: 0 auto !important;
    text-align: center !important;
    pointer-events: none;
    z-index: 5;
    flex-shrink: 0;
  }

  .scene-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: #d94e28;
    display: inline-block;
    margin-bottom: 4px;
  }

  .scene-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 400;
    font-style: italic;
    color: #fff;
    margin: 0 0 8px;
    filter: url(#ink-displacement);
  }

  .beat-text {
    font-family: var(--font-editorial);
    font-size: clamp(0.92rem, 1.7vw, 1.05rem);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    margin: 0;
  }

  .milu-quote {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.5vw, 1.7rem);
    font-style: italic;
    color: #d94e28;
    line-height: 1.45;
    margin: 0;
  }

  .milu-quote cite {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-style: normal;
    color: #e6d7b9;
    margin-top: 8px;
    letter-spacing: 0.08em;
  }

  /* China Rig Architecture */
  .china-rig {
    width: 100%;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    z-index: 2;
    margin-top: 2px;
  }

  /* Technical Math Panel */
  .math-panel {
    display: flex;
    align-items: center;
    justify-content: space-around;
    width: 100%;
    padding: 12px 18px;
    gap: 12px;
  }

  .math-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2px;
    flex: 1;
  }

  .col-title {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .col-formula {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .col-val {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    color: var(--fg-ink);
    margin-top: 2px;
  }

  .col-accent {
    color: #d94e28;
  }

  .math-divider {
    width: 1px;
    height: 38px;
    background: var(--grid-line);
  }

  @media (max-height: 750px) {
    .narrative {
      min-height: 95px;
    }
  }
</style>
