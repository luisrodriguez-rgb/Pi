---
import { MILESTONES } from '../../data/milestones';
import { FORMULAS } from '../../data/formulas';
import { type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const milestone = MILESTONES[8];
const spigot = FORMULAS.dikWinterSpigot;
const circularCode = `                 #include <stdio.h>
               int a=10000,b,c=2800,d,e,
             f[2801],g;main(){for(;b-c;)f[b++]=
            a/5;for(;d=0,g=c*2;c-=14,printf("%.4d",
           e+d/a),e=d%a)for(b=c;d+=f[b]*a,f[b]=d%--g,
          d/=g--,--b;d*=b);} /* Spigot Pi Algorithm */`;
---

<section 
  id="scene-9" 
  class="scene" 
  data-scene="cyber" 
  data-year={milestone.year}
  data-pi-value={milestone.precisionValue}
  data-theme={milestone.theme}
  data-scene-title={milestone.title[locale]}
>
  <div class="stage">
    <!-- Narrative Header (Non-collapsible, balanced typography positioned cleanly above terminal) -->
    <div class="narrative choreo-header">
      <div class="beat" data-beat="0.05-0.38">
        <span class="scene-kicker">09 // PASADENA Y AMSTERDAM · CULTO HACKER</span>
        <h2 class="scene-title">{milestone.title[locale]}</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'Dos joyas de la mitología computacional. Primero, Richard Feynman bromearía con memorizar π hasta la posición 762 solo para recitar: «nueve, nueve, nueve, nueve, nueve, nueve... y así sucesivamente», fingiendo que π era un número racional.'
            : 'Two icons of computational mythology. First, Richard Feynman quipped he would memorize π to index 762 simply to recite: «nine, nine, nine, nine, nine, nine... and so on», pretending π was a rational periodic fraction.'}
        </p>
      </div>

      <div class="beat" data-beat="0.42-0.80">
        <span class="scene-kicker">09 // EL CÓDIGO CIRCULAR DE 160 CARACTERES</span>
        <h2 class="scene-title">El Grifo (Spigot) de Dik Winter</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'En 1997, Dik Winter y Achim Flammenkamp ganaron el legendario concurso IOCCC con 160 caracteres formateados con la silueta de un círculo. Cero decimales flotantes: solo aritmética entera en base mixta que gotea dígitos de 4 en 4.'
            : 'In 1997, Dik Winter and Achim Flammenkamp won the IOCCC contest with 160 characters formatted into the physical geometry of a circle. Zero floating-point numbers: pure mixed-radix integer arithmetic dripping digits 4 by 4.'}
        </p>
      </div>

      <div class="beat beat-climax" data-beat="0.84-0.98">
        <blockquote class="hacker-quote">
          <p>«El código se convirtió en la geometría misma de lo que calcula.»</p>
          <cite>— Dik T. Winter &amp; Richard Feynman</cite>
        </blockquote>
      </div>
    </div>

    <!-- The Dual Feynman Odometer & Interactive CRT Spigot Terminal Rig -->
    <div class="hacker-stage choreo-artifact" id="hacker-stage">
      <!-- Museum Catalog Technical Plate (In-Flow, Zero Collisions) -->
      <div class="museum-plate">
        [ FIG. 09 // AMSTERDAM, 1988 — IOCCC WINNER // SPIGOT BASE MIXTA ]
      </div>

      <!-- 1. The Feynman 999999 Odometer -->
      <div class="feynman-strip blueprint-panel" id="feynman-strip">
        <div class="feynman-header">
          <span class="f-pos">PUNTO DE FEYNMAN (DECIMAL #762):</span>
          <span class="f-badge">6 NUEVES CONSECUTIVOS</span>
        </div>
        <div class="f-stream-row">
          <span class="f-prefix">...314159...</span>
          <div class="f-cluster" id="feynman-cluster">
            <span class="f-nine">9</span>
            <span class="f-nine">9</span>
            <span class="f-nine">9</span>
            <span class="f-nine">9</span>
            <span class="f-nine">9</span>
            <span class="f-nine">9</span>
          </div>
          <span class="f-next" id="f-next-digit">8731...</span>
        </div>
      </div>

      <!-- 2. Interactive Circular C Spigot Terminal (CRT Phosphor) -->
      <div class="circle-code-terminal blueprint-panel">
        <div class="term-header">
          <div class="term-lights">
            <span class="term-dot red"></span>
            <span class="term-dot yellow"></span>
            <span class="term-dot green"></span>
          </div>
          <span class="term-title">dik_winter_pi_circle.c (IOCCC 1997)</span>
          <div class="term-status" id="term-status">STANDBY // READY</div>
        </div>

        <!-- Terminal Body with Scanlines -->
        <div class="term-body">
          <pre class="circle-c-pre"><code>{circularCode}</code></pre>
          
          <!-- Live Dripping Output Area -->
          <div class="stream-line">
            <span class="prompt">$ ./pi_circle &gt;</span>
            <span class="stream-output" id="spigot-output">3141 5926 5358 9793 2384 6264 3383...</span>
            <span class="term-cursor">█</span>
          </div>
        </div>

        <!-- Terminal Interactive Controls -->
        <div class="term-controls choreo-metrics">
          <button type="button" id="btn-run-spigot" class="term-btn" title="Iniciar ejecución del algoritmo Spigot">
            <span class="btn-icon">▶</span>
            <span id="run-btn-label">GOTEAR DÍGITOS</span>
          </button>
          <button type="button" id="btn-feynman-highlight" class="term-btn term-btn-amber" title="Destacar el punto de Feynman">
            <span class="btn-icon">⚡</span>
            <span>DESTACAR FEYNMAN #762</span>
          </button>
          <button type="button" id="btn-reset-spigot" class="term-btn term-btn-dim" title="Reiniciar búfer de salida">
            <span class="btn-icon">↺</span>
            <span>REINICIAR</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { soundEngine } from '../../scripts/audio';

  const hackerStage = document.getElementById('hacker-stage');
  const nextDigit = document.getElementById('f-next-digit');
  const spigotOutput = document.getElementById('spigot-output');
  const termStatus = document.getElementById('term-status');
  const runBtn = document.getElementById('btn-run-spigot');
  const runBtnLabel = document.getElementById('run-btn-label');
  const feynmanBtn = document.getElementById('btn-feynman-highlight');
  const feynmanCluster = document.getElementById('feynman-cluster');
  const resetBtn = document.getElementById('btn-reset-spigot');

  // Precomputed Spigot chunks for high-speed fluid execution
  const piChunks = [
    '3141', '5926', '5358', '9793', '2384', '6264', '3383', '2795',
    '0288', '4197', '1693', '9937', '5105', '8209', '7494', '4592',
    '3078', '1640', '6286', '2089', '9862', '8034', '8253', '4211',
    '7067', '9821', '4808', '6513', '2823', '0664', '7093', '8446'
  ];

  let isRunning = false;
  let intervalId: any = null;
  let currentChunkIdx = 7;

  function toggleSpigotStream() {
    isRunning = !isRunning;
    if (isRunning) {
      if (termStatus) termStatus.textContent = 'RUNNING // MIXED-RADIX SPIGOT';
      if (runBtnLabel) runBtnLabel.textContent = 'PAUSAR';
      runBtn?.classList.add('is-active');

      intervalId = setInterval(() => {
        if (currentChunkIdx < piChunks.length) {
          currentChunkIdx++;
          if (spigotOutput) {
            spigotOutput.textContent = piChunks.slice(0, currentChunkIdx).join(' ') + '...';
          }
          soundEngine.playDigit(currentChunkIdx % 10);
        } else {
          currentChunkIdx = 1;
        }
      }, 220);
    } else {
      clearInterval(intervalId);
      if (termStatus) termStatus.textContent = 'PAUSED // IDLE';
      if (runBtnLabel) runBtnLabel.textContent = 'GOTEAR DÍGITOS';
      runBtn?.classList.remove('is-active');
    }
  }

  runBtn?.addEventListener('click', toggleSpigotStream);

  feynmanBtn?.addEventListener('click', () => {
    feynmanCluster?.classList.toggle('is-pulse');
    soundEngine.playFeynmanResolution();
  });

  resetBtn?.addEventListener('click', () => {
    if (isRunning) toggleSpigotStream();
    currentChunkIdx = 7;
    if (spigotOutput) {
      spigotOutput.textContent = piChunks.slice(0, 7).join(' ') + '...';
    }
    if (termStatus) termStatus.textContent = 'RESET // READY';
  });

  if (hackerStage) {
    const scene = hackerStage.closest('[data-scene]') as HTMLElement | null;
    let chordFired = false;

    window.addEventListener('scroll', () => {
      if (!scene) return;
      const p = parseFloat(getComputedStyle(scene).getPropertyValue('--p')) || 0;

      if (p > 0.45 && !chordFired) {
        chordFired = true;
        soundEngine.playFeynmanResolution();
        feynmanCluster?.classList.add('is-pulse');
      } else if (p < 0.2) {
        chordFired = false;
        feynmanCluster?.classList.remove('is-pulse');
      }

      nextDigit?.classList.toggle('is-revealed', p > 0.75);
    }, { passive: true });
  }
</script>

<style>
  .scene {
    height: 380vh;
    position: relative;
    --p: 0;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    background: radial-gradient(circle at 50% 50%, #0d1624 0%, #050a10 100%);
    padding: calc(var(--hud-height, 68px) + 12px) 20px 16px;
    box-sizing: border-box;
    gap: 8px;
  }

  .hacker-stage {
    position: relative;
    width: 100%;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-top: 2px;
    z-index: 2;
  }

  /* Uncollapsible Narrative Box Positioned Above Rig */
  .narrative {
    position: relative;
    width: 100% !important;
    max-width: min(90vw, 740px) !important;
    min-height: 115px;
    margin: 0 auto !important;
    text-align: center !important;
    pointer-events: none;
    z-index: 5;
    flex-shrink: 0;
  }

  .scene-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: #39ff88;
    display: inline-block;
    margin-bottom: 4px;
  }

  .scene-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 400;
    font-style: italic;
    color: #fff;
    margin: 0 0 8px;
    filter: url(#ink-displacement);
  }

  .beat-text {
    font-family: var(--font-editorial);
    font-size: clamp(0.92rem, 1.7vw, 1.05rem);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    margin: 0;
  }

  .hacker-quote {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.5vw, 1.7rem);
    font-style: italic;
    color: #39ff88;
    line-height: 1.45;
    margin: 0;
  }

  .hacker-quote cite {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-style: normal;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 8px;
    letter-spacing: 0.05em;
  }

  /* 1. Feynman Strip Odometer */
  .feynman-strip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 100%;
    padding: 8px 16px;
    border: 1px solid rgba(57, 255, 136, 0.3) !important;
    background: rgba(10, 20, 16, 0.85) !important;
  }

  .feynman-header {
    display: flex;
    justify-content: space-between;
    width: 100%;
    align-items: center;
  }

  .f-pos {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .f-badge {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    color: #39ff88;
    background: rgba(57, 255, 136, 0.1);
    border: 1px solid rgba(57, 255, 136, 0.3);
    padding: 2px 6px;
  }

  .f-stream-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 1.15rem;
  }

  .f-prefix {
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.95rem;
  }

  .f-cluster {
    display: inline-flex;
    gap: 4px;
    transition: all 0.3s ease;
  }

  .f-nine {
    color: #ffaa00;
    font-weight: 700;
    text-shadow: 0 0 10px rgba(255, 170, 0, 0.5);
  }

  .f-cluster.is-pulse .f-nine {
    color: #39ff88;
    text-shadow: 0 0 14px #39ff88;
  }

  .f-next {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.95rem;
    transition: color 0.3s ease;
  }

  .f-next.is-revealed {
    color: var(--fg-ink);
  }

  /* 2. Circular C Spigot Terminal */
  .circle-code-terminal {
    width: 100%;
    background: #040906 !important;
    border: 1px solid rgba(57, 255, 136, 0.35) !important;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    box-shadow: 0 0 30px rgba(0, 0, 0, 0.8);
  }

  /* CRT Scanlines */
  .circle-code-terminal::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.15) 0px,
      rgba(0, 0, 0, 0.15) 1px,
      transparent 1px,
      transparent 2px
    );
    opacity: 0.6;
  }

  .term-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 12px;
    border-bottom: 1px solid rgba(57, 255, 136, 0.2);
    background: rgba(10, 25, 16, 0.95);
  }

  .term-lights {
    display: flex;
    gap: 6px;
  }

  .term-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .term-dot.red { background: #e63946; }
  .term-dot.yellow { background: #ffaa00; }
  .term-dot.green { background: #39ff88; }

  .term-title {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: #39ff88;
  }

  .term-status {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .term-body {
    padding: 10px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .circle-c-pre {
    margin: 0;
    font-family: 'B612 Mono', monospace;
    font-size: clamp(0.68rem, 1.3vw, 0.8rem);
    line-height: 1.25;
    color: #39ff88;
    text-shadow: 0 0 8px rgba(57, 255, 136, 0.4);
    overflow-x: auto;
    text-align: center;
  }

  .stream-line {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 6px 10px;
    background: rgba(0, 0, 0, 0.6);
    border-top: 1px solid rgba(57, 255, 136, 0.2);
    overflow-x: hidden;
  }

  .prompt {
    color: #ffaa00;
  }

  .stream-output {
    color: #39ff88;
    letter-spacing: 0.05em;
  }

  .term-cursor {
    color: #39ff88;
    animation: blink 0.9s infinite step-start;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  /* Interactive Controls */
  .term-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px 12px;
    border-top: 1px solid rgba(57, 255, 136, 0.2);
    background: rgba(10, 20, 14, 0.9);
  }

  .term-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: 1px solid rgba(57, 255, 136, 0.4);
    color: #39ff88;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    padding: 5px 12px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .term-btn:hover, .term-btn.is-active {
    background: rgba(57, 255, 136, 0.18);
    border-color: #39ff88;
    box-shadow: 0 0 10px rgba(57, 255, 136, 0.4);
  }

  .term-btn-amber {
    border-color: rgba(255, 170, 0, 0.4);
    color: #ffaa00;
  }

  .term-btn-amber:hover {
    border-color: #ffaa00;
    color: #ffaa00;
    background: rgba(255, 170, 0, 0.15);
    box-shadow: 0 0 10px rgba(255, 170, 0, 0.4);
  }

  .term-btn-dim {
    border-color: var(--grid-line);
    color: var(--muted);
  }

  .term-btn-dim:hover {
    border-color: var(--muted);
    color: var(--fg-ink);
  }

  @media (max-height: 750px) {
    .circle-c-pre {
      font-size: 0.62rem;
    }
    .narrative {
      min-height: 95px;
    }
  }
</style>
