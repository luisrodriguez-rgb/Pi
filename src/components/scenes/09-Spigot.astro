---
import { MILESTONES } from '../../data/milestones';
import { FORMULAS } from '../../data/formulas';
import { type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const milestone = MILESTONES[8];
const spigot = FORMULAS.dikWinterSpigot;
const circularCode = `                 #include <stdio.h>
              int a=10000,b,c=2800,d,e,
            f[2801],g;main(){for(;b-c;)f[b++]=
           a/5;for(;d=0,g=c*2;c-=14,printf("%.4d",
          e+d/a),e=d%a)for(b=c;d+=f[b]*a,f[b]=d%--g,
         d/=g--,--b;d*=b);} /* Spigot Pi Algorithm */`;
---

<section 
  id="scene-9" 
  class="scene" 
  data-scene="cyber" 
  data-year={milestone.year}
  data-pi-value={milestone.precisionValue}
  data-theme={milestone.theme}
  data-scene-title={milestone.title[locale]}
>
  <div class="stage">
    <!-- Narrative Center (Uncollapsible, balanced typography) -->
    <div class="narrative">
      <div class="beat" data-beat="0.05-0.38">
        <span class="scene-kicker">09 // PASADENA Y AMSTERDAM · CULTO HACKER</span>
        <h2 class="scene-title">{milestone.title[locale]}</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'Dos joyas de la mitología computacional. Primero, Richard Feynman bromearía con memorizar π hasta la posición 762 solo para recitar: «nueve, nueve, nueve, nueve, nueve, nueve... y así sucesivamente», fingiendo que π era un número racional.'
            : 'Two icons of computational mythology. First, Richard Feynman quipped he would memorize π to index 762 simply to recite: «nine, nine, nine, nine, nine, nine... and so on», pretending π was a rational periodic fraction.'}
        </p>
      </div>

      <div class="beat" data-beat="0.42-0.80">
        <span class="scene-kicker">09 // EL CÓDIGO CIRCULAR DE 160 CARACTERES</span>
        <h2 class="scene-title">El Grifo (Spigot) de Dik Winter</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'En 1997, Dik Winter y Achim Flammenkamp ganaron el legendario concurso IOCCC con 160 caracteres formateados con la silueta de un círculo. Cero decimales flotantes: solo aritmética entera en base mixta que gotea dígitos de 4 en 4.'
            : 'In 1997, Dik Winter and Achim Flammenkamp won the IOCCC contest with 160 characters formatted into the physical geometry of a circle. Zero floating-point numbers: pure mixed-radix integer arithmetic dripping digits 4 by 4.'}
        </p>
      </div>

      <div class="beat beat-climax" data-beat="0.84-0.98">
        <blockquote class="hacker-quote">
          <p>«El código se convirtió en la geometría misma de lo que calcula.»</p>
          <cite>— Dik T. Winter &amp; Richard Feynman</cite>
        </blockquote>
      </div>
    </div>

    <!-- The Dual Feynman Odometer & Circular C Terminal Rig -->
    <div class="hacker-stage" id="hacker-stage">
      <!-- 1. The Feynman 999999 Odometer -->
      <div class="feynman-strip" id="feynman-strip">
        <span class="f-pos">DECIMAL #762:</span>
        <div class="f-cluster">
          <span class="f-nine">9</span>
          <span class="f-nine">9</span>
          <span class="f-nine">9</span>
          <span class="f-nine">9</span>
          <span class="f-nine">9</span>
          <span class="f-nine">9</span>
        </div>
        <span class="f-next" id="f-next-digit">...8731</span>
      </div>

      <!-- 2. Circular C Spigot Code in IBM Plex Mono -->
      <div class="circle-code-terminal">
        <div class="term-header">
          <span class="term-dot red"></span>
          <span class="term-dot yellow"></span>
          <span class="term-dot green"></span>
          <span class="term-title">dik_winter_pi_circle.c (IOCCC 1997)</span>
        </div>
        <pre class="circle-c-pre"><code>{circularCode}</code></pre>
        <div class="stream-line">
          <span class="prompt">$ ./pi_circle</span>
          <span class="stream-output">3141 5926 5358 9793 2384 6264 3383 2795...</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { soundEngine } from '../../scripts/audio';

  const hackerStage = document.getElementById('hacker-stage');
  const nextDigit = document.getElementById('f-next-digit');

  if (hackerStage) {
    const scene = hackerStage.closest('[data-scene]') as HTMLElement | null;
    let chordFired = false;

    window.addEventListener('scroll', () => {
      if (!scene) return;
      const p = parseFloat(getComputedStyle(scene).getPropertyValue('--p')) || 0;

      if (p > 0.45 && !chordFired) {
        chordFired = true;
        soundEngine.playFeynmanResolution();
      } else if (p < 0.2) {
        chordFired = false;
      }

      nextDigit?.classList.toggle('is-revealed', p > 0.75);
    }, { passive: true });
  }
</script>

<style>
  .scene {
    height: 380vh;
    position: relative;
    --p: 0;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: radial-gradient(circle at 50% 50%, #0d1624 0%, #050a10 100%);
    padding: 0 20px;
  }

  /* Uncollapsible Narrative Box */
  .narrative {
    position: absolute;
    top: 9vh;
    width: 100% !important;
    max-width: min(90vw, 740px) !important;
    margin: 0 auto !important;
    text-align: center !important;
    pointer-events: none;
    z-index: 5;
  }

  .beat {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    width: 100% !important;
  }

  .beat.is-active {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    pointer-events: auto;
  }

  .scene-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: #00e5ff;
    display: inline-block;
    margin-bottom: 6px;
  }

  .scene-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.8vw, 2.8rem);
    font-weight: 400;
    color: #fff;
    margin: 0 0 10px;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.9);
  }

  .beat-text {
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.8vw, 1.12rem);
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.65;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
  }

  .hacker-quote {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.8vw, 1.9rem);
    font-style: italic;
    color: #00e5ff;
    line-height: 1.5;
    margin: 0;
    text-shadow: 0 0 25px rgba(0, 229, 255, 0.5);
  }

  .hacker-quote cite {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-style: normal;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 10px;
    letter-spacing: 0.05em;
  }

  .hacker-stage {
    margin-top: 18vh;
    width: min(92vw, 760px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    z-index: 2;
  }

  .feynman-strip {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(10, 18, 28, 0.9);
    border: 1px solid rgba(0, 229, 255, 0.3);
    border-radius: 12px;
    padding: 10px 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
  }

  .f-pos {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .f-cluster {
    display: flex;
    gap: 4px;
  }

  .f-nine {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    font-weight: 700;
    color: #ffb703;
    text-shadow: 0 0 10px rgba(255, 183, 3, 0.6);
  }

  .f-next {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: #00e5ff;
    opacity: 0.2;
    transition: opacity 0.3s ease;
  }

  .f-next.is-revealed {
    opacity: 0.9;
  }

  .circle-code-terminal {
    width: 100%;
    background: #060b12;
    border: 1px solid rgba(0, 229, 255, 0.25);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85);
  }

  .term-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .term-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .term-dot.red { background: #ff5f56; }
  .term-dot.yellow { background: #ffbd2e; }
  .term-dot.green { background: #27c93f; }

  .term-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
    margin-left: 6px;
  }

  .circle-c-pre {
    margin: 0;
    padding: 18px 24px;
    font-family: var(--font-mono);
    font-size: clamp(0.7rem, 1.35vw, 0.88rem);
    color: #79c0ff;
    line-height: 1.5;
    overflow-x: auto;
  }

  .stream-line {
    display: flex;
    gap: 12px;
    padding: 10px 20px;
    background: rgba(0, 0, 0, 0.4);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .prompt {
    color: #27c93f;
  }

  .stream-output {
    color: #00e5ff;
  }
</style>
