---
import { MILESTONES } from '../../data/milestones';
import { type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const milestone = MILESTONES[7];
---

<section 
  id="scene-8" 
  class="scene" 
  data-scene="feynman" 
  data-year={milestone.year}
  data-pi-value={milestone.piApproximation}
  data-theme={milestone.theme}
  data-scene-title={milestone.title[locale]}
>
  <div class="stage">
    <!-- Narrative beats -->
    <div class="narrative">
      <div class="beat" data-beat="0.05-0.38">
        <span class="scene-kicker">08 // PASADENA, 1989 d.C.</span>
        <h2 class="scene-title">{milestone.title[locale]}</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'En una secuencia aleatoria infinita, encontrar seis dígitos idénticos consecutivos tan temprano tiene una probabilidad de apenas 0.08%. Pero en el decimal 762 de π, el universo gastó una broma cósmica.'
            : 'In an infinite pseudo-random stream, finding six consecutive identical digits this early carries less than a 0.08% chance. Yet at decimal 762 of π, the cosmos played an astonishing joke.'}
        </p>
      </div>

      <div class="beat" data-beat="0.42-0.78">
        <span class="scene-kicker">08 // LA ILUSIÓN DE RACIONALIDAD</span>
        <h2 class="scene-title">«9, 9, 9, 9, 9, 9... y así sucesivamente»</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'Richard Feynman deseaba memorizar π hasta este punto exacto para recitar los seis nueves y exclamar "...y así sucesivamente", fingiendo que π finalmente se convertía en una fracción periódica racional.'
            : 'Richard Feynman wished to memorize π to this exact marker so he could recite the six nines and say "...and so on", pretending π had finally resolved into a periodic rational fraction.'}
        </p>
      </div>

      <div class="beat" data-beat="0.82-0.98">
        <span class="scene-kicker">08 // SE ROMPE EL ESPEJISMO</span>
        <h2 class="scene-title">El Infinito Continúa</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'Inmediatamente después del sexto nueve aparece un 8. El espejismo se derrumba y π reanuda su danza aperiódica hacia la eternidad.'
            : 'Immediately following the sixth nine, an 8 appears. The illusion collapses and π resumes its aperiodic journey into eternity.'}
        </p>
      </div>
    </div>

    <!-- The Feynman High-Speed Odometer -->
    <div class="odometer-rig" id="feynman-rig">
      <div class="odometer-header">
        <span class="pos-badge">DECIMAL INDEX: <strong id="odo-index">762</strong></span>
        <span class="status-badge" id="odo-status">SCROLLING THROUGH STREAM</span>
      </div>

      <div class="odometer-box">
        <!-- Leading context -->
        <div class="digit-context pre-context">
          <span>...8</span><span>5</span><span>7</span><span>9</span><span>7</span><span>3</span>
        </div>

        <!-- The Six Nines Reel (Feynman Point) -->
        <div class="six-nines-cluster" id="six-nines">
          <div class="reel-cell"><div class="reel-strip"><span class="r-num">9</span></div></div>
          <div class="reel-cell"><div class="reel-strip"><span class="r-num">9</span></div></div>
          <div class="reel-cell"><div class="reel-strip"><span class="r-num">9</span></div></div>
          <div class="reel-cell"><div class="reel-strip"><span class="r-num">9</span></div></div>
          <div class="reel-cell"><div class="reel-strip"><span class="r-num">9</span></div></div>
          <div class="reel-cell"><div class="reel-strip"><span class="r-num">9</span></div></div>
        </div>

        <!-- Trailing context (Next digits: 873115) -->
        <div class="digit-context post-context" id="post-context">
          <span>8</span><span>7</span><span>3</span><span>1</span><span>1</span><span>5...</span>
        </div>
      </div>

      <!-- Probability footnote -->
      <div class="odometer-footer">
        <span class="f-prob">Probabilidad de aparición temprana: <strong>P &lt; 0.08%</strong></span>
        <span class="f-anomaly">ANOMALÍA ESTADÍSTICA DE FEYNMAN</span>
      </div>
    </div>
  </div>
</section>

<script>
  import { soundEngine } from '../../scripts/audio';

  const rig = document.getElementById('feynman-rig');
  const sixNines = document.getElementById('six-nines');
  const postContext = document.getElementById('post-context');
  const odoStatus = document.getElementById('odo-status');
  const odoIndex = document.getElementById('odo-index');

  if (rig && sixNines) {
    const scene = rig.closest('[data-scene]') as HTMLElement | null;
    let chordTriggered = false;

    window.addEventListener('scroll', () => {
      if (!scene) return;
      const p = parseFloat(getComputedStyle(scene).getPropertyValue('--p')) || 0;

      // Reel position calculation
      const currentIndex = Math.floor(100 + p * 662);
      if (odoIndex) odoIndex.textContent = String(Math.min(762, currentIndex));

      // When centered on 999999 (p between 0.45 and 0.80)
      const isLocked = p >= 0.42 && p <= 0.82;
      sixNines.classList.toggle('is-locked', isLocked);

      if (isLocked) {
        if (odoStatus) odoStatus.textContent = '★ FEYNMAN POINT REACHED: 999999';
        if (!chordTriggered) {
          chordTriggered = true;
          soundEngine.playFeynmanResolution();
        }
      } else {
        if (odoStatus) odoStatus.textContent = p > 0.82 ? 'ILLUSION SHATTERED // RESUMING ∞' : 'SCANNING DIGIT STREAM...';
        if (p < 0.3) chordTriggered = false;
      }

      if (postContext) {
        postContext.classList.toggle('is-revealed', p > 0.82);
      }
    }, { passive: true });
  }
</script>

<style>
  .scene {
    height: 380vh;
    position: relative;
    --p: 0;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: radial-gradient(circle at 50% 50%, #1c1417 0%, #0c080a 100%);
    padding: 0 20px;
  }

  .narrative {
    position: absolute;
    top: 10vh;
    max-width: 680px;
    text-align: center;
    pointer-events: none;
    z-index: 5;
  }

  .beat {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
  }

  .beat.is-active {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    pointer-events: auto;
  }

  .scene-kicker {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: #ff3366;
    display: inline-block;
    margin-bottom: 6px;
  }

  .scene-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 400;
    color: #fff;
    margin: 0 0 10px;
  }

  .beat-text {
    font-family: var(--font-sans);
    font-size: clamp(0.9rem, 1.6vw, 1.05rem);
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.5;
    margin: 0;
  }

  .odometer-rig {
    position: relative;
    margin-top: 20vh;
    width: min(94vw, 840px);
    background: rgba(20, 14, 18, 0.85);
    border: 1px solid rgba(255, 51, 102, 0.25);
    border-radius: 16px;
    padding: 24px 30px;
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.8), inset 0 0 20px rgba(255, 51, 102, 0.05);
    backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    gap: 20px;
    z-index: 2;
  }

  .odometer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .pos-badge {
    color: rgba(255, 255, 255, 0.5);
  }

  .pos-badge strong {
    color: #ffd700;
    font-size: 1rem;
  }

  .status-badge {
    color: #ff3366;
    letter-spacing: 0.08em;
  }

  .odometer-box {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 24px 12px;
    background: #090608;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .digit-context {
    display: flex;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: clamp(1.2rem, 3vw, 2rem);
    color: rgba(255, 255, 255, 0.25);
  }

  .post-context {
    opacity: 0.15;
    transition: opacity 0.4s ease, color 0.4s ease;
  }

  .post-context.is-revealed {
    opacity: 0.85;
    color: #00ffcc;
  }

  .six-nines-cluster {
    display: flex;
    gap: 6px;
    padding: 6px 12px;
    border: 2px solid rgba(255, 51, 102, 0.4);
    border-radius: 8px;
    background: rgba(255, 51, 102, 0.05);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .six-nines-cluster.is-locked {
    border-color: #ffd700;
    background: rgba(255, 215, 0, 0.12);
    box-shadow: 0 0 35px rgba(255, 215, 0, 0.4), inset 0 0 15px rgba(255, 215, 0, 0.2);
    transform: scale(1.05);
  }

  .reel-cell {
    width: clamp(28px, 5vw, 44px);
    height: clamp(48px, 8vw, 70px);
    background: #140d12;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .reel-strip {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .r-num {
    font-family: var(--font-mono);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 700;
    color: #ff3366;
    transition: color 0.3s ease;
  }

  .six-nines-cluster.is-locked .r-num {
    color: #ffd700;
    text-shadow: 0 0 15px rgba(255, 215, 0, 0.8);
  }

  .odometer-footer {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .odometer-footer strong {
    color: #ff3366;
  }

  @media (max-width: 650px) {
    .digit-context {
      display: none;
    }
  }
</style>
