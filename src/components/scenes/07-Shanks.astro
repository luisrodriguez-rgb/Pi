---
import { MILESTONES } from '../../data/milestones';
import { type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const milestone = MILESTONES[6];
---

<section 
  id="scene-7" 
  class="scene" 
  data-scene="shanks" 
  data-year={milestone.year}
  data-pi-value={milestone.precisionValue}
  data-theme={milestone.theme}
  data-scene-title={milestone.title[locale]}
>
  <div class="stage">
    <!-- Narrative Header (Non-collapsible, elegant typography positioned cleanly above dome) -->
    <div class="narrative choreo-header">
      <div class="beat" data-beat="0.05-0.38">
        <span class="scene-kicker">07 // HOUGHTON-LE-SPRING, 1873 · INGLATERRA</span>
        <h2 class="scene-title">{milestone.title[locale]}</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'William Shanks dedicó veinte años de su existencia a calcular a mano, con pluma y tintero, 707 cifras de π. En 1937, la Exposición Universal de París rindió homenaje a su hazaña tallando sus 707 números en madera dorada alrededor de la cúpula del Palais de la Découverte.'
            : 'William Shanks surrendered twenty years of his life calculating by hand, with ink and quill, 707 decimal places of π. In 1937, the Paris Universal Exposition honored his titan sacrifice by carving all 707 numerals in gilded wood around the dome of the Palais de la Découverte.'}
        </p>
      </div>

      <div class="beat" data-beat="0.42-0.80">
        <span class="scene-kicker">07 // LA CATÁSTROFE DEL DÍGITO 528</span>
        <h2 class="scene-title">El Derrumbe de la Cúpula</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'En 1944, D. F. Ferguson utilizó una calculadora mecánica y detectó la tragedia: Shanks había cometido un error en el decimal 528 (escribió un 4 donde iba un 5). A partir de ese número, las restantes 180 cifras no eran más que escombros y polvo.'
            : 'In 1944, D. F. Ferguson used a mechanical desktop calculator and discovered the tragedy: Shanks erred at the 528th decimal (writing a 4 instead of a 5). From that single fracture, the remaining 180 digits collapsed into ash.'}
        </p>
      </div>

      <div class="beat beat-climax" data-beat="0.84-0.98">
        <blockquote class="shanks-quote">
          <p>«Veinte años de vigilia y tinta consumidos por el desliz de una sola pluma.»</p>
          <cite>— D. F. Ferguson (1944) corrigiendo a William Shanks (1873)</cite>
        </blockquote>
      </div>
    </div>

    <!-- Architectural Dome of Palais de la Découverte Rig (Fully Visible, Zero Cut-offs) -->
    <div class="dome-stage choreo-artifact" id="shanks-dome">
      <!-- Museum Catalog Technical Plate (In-Flow) -->
      <div class="museum-plate">
        [ FIG. 07 // HOUGHTON, 1873 — BÓVEDA PALAIS DE LA DÉCOUVERTE — ERROR #528 ]
      </div>

      <div class="dome-display blueprint-panel">
        <!-- Dome Architectural SVG -->
        <div class="dome-svg-wrap">
          <svg viewBox="0 0 320 160" class="dome-svg" aria-label="Bóveda del Palais de la Découverte">
            <defs>
              <radialGradient id="oculus-glow" cx="50%" cy="100%" r="90%">
                <stop offset="0%" stop-color="#e63946" stop-opacity="0.35" />
                <stop offset="60%" stop-color="#c59b27" stop-opacity="0.12" />
                <stop offset="100%" stop-color="#0a0607" stop-opacity="0" />
              </radialGradient>
            </defs>

            <!-- Dome Arches / Ribs -->
            <path d="M 20 150 A 140 130 0 0 1 300 150" fill="none" stroke="rgba(197, 155, 39, 0.25)" stroke-width="1.5" />
            <path d="M 50 150 A 110 105 0 0 1 270 150" fill="none" stroke="rgba(197, 155, 39, 0.4)" stroke-width="1.2" />
            <path d="M 80 150 A 80 80 0 0 1 240 150" fill="url(#oculus-glow)" stroke="rgba(230, 57, 70, 0.5)" stroke-width="1.5" />
            
            <!-- Radial Dome Meridians -->
            <line x1="160" y1="20" x2="160" y2="150" stroke="rgba(197, 155, 39, 0.3)" stroke-width="1" stroke-dasharray="3,3" />
            <line x1="80" y1="55" x2="160" y2="150" stroke="rgba(197, 155, 39, 0.2)" stroke-width="1" />
            <line x1="240" y1="55" x2="160" y2="150" stroke="rgba(197, 155, 39, 0.2)" stroke-width="1" />

            <!-- Oculus Spotlight -->
            <circle cx="160" cy="150" r="18" fill="rgba(230, 57, 70, 0.4)" stroke="#e63946" stroke-width="1.5" />
            <text x="160" y="154" fill="#fff" font-family="var(--font-mono)" font-size="9" text-anchor="middle">528</text>
          </svg>
        </div>

        <!-- The Focal Point: Digit 528 vs the Collapsed 180 Digits -->
        <div class="dome-inspection">
          <div class="digits-sequence">
            <span class="d-chunk d-valid">...525: 4 9 3 0</span>
            
            <!-- THE FATAL DIGIT 528 -->
            <button type="button" class="d-fatal" id="shanks-fatal-528" title="Clic para inspeccionar el error">
              <span class="fatal-index">#528</span>
              <strong class="fatal-digit">4</strong>
              <span class="fatal-correct-hint">era 5</span>
            </button>

            <!-- The 180 crumbling digits that collapse into ash -->
            <div class="crumbling-ash-stream" id="crumbling-stream">
              <span class="d-crumb c-1">3</span>
              <span class="d-crumb c-2">8</span>
              <span class="d-crumb c-3">1</span>
              <span class="d-crumb c-4">9</span>
              <span class="d-crumb c-5">5</span>
              <span class="d-crumb c-6">2</span>
              <span class="d-crumb c-7">8</span>
              <span class="d-crumb c-8">4</span>
              <span class="d-crumb c-9">7</span>
              <span class="d-crumb c-10">5...</span>
              <span class="ash-label">[180 CIFRAS DERRUMBADAS]</span>
            </div>
          </div>

          <!-- Interactive Fracture Switch -->
          <div class="shanks-controls choreo-metrics">
            <button type="button" id="toggle-shanks-btn" class="shanks-btn">
              <span class="shanks-btn-dot"></span>
              <span id="shanks-btn-text">INSPECCIONAR COLAPSO #528</span>
            </button>
            <span class="shanks-status-note" id="shanks-note">
              {locale === 'es' 
                ? 'El desliz en el decimal 528 convirtió las siguientes 180 cifras en números sin valor.'
                : 'The slip at decimal 528 turned the following 180 figures into meaningless dust.'}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const dome = document.getElementById('shanks-dome');
  const fatalEl = document.getElementById('shanks-fatal-528');
  const streamEl = document.getElementById('crumbling-stream');
  const toggleBtn = document.getElementById('toggle-shanks-btn');
  const btnText = document.getElementById('shanks-btn-text');

  let manuallyToggled = false;

  function setFractureState(isFailed: boolean) {
    fatalEl?.classList.toggle('is-error', isFailed);
    streamEl?.classList.toggle('is-fallen', isFailed);
    if (btnText) {
      btnText.textContent = isFailed ? 'RESTAURAR CÚPULA' : 'INSPECCIONAR COLAPSO #528';
    }
  }

  toggleBtn?.addEventListener('click', () => {
    manuallyToggled = true;
    const isNowFailed = !fatalEl?.classList.contains('is-error');
    setFractureState(isNowFailed);
  });

  fatalEl?.addEventListener('click', () => {
    manuallyToggled = true;
    const isNowFailed = !fatalEl?.classList.contains('is-error');
    setFractureState(isNowFailed);
  });

  if (dome) {
    const scene = dome.closest('[data-scene]') as HTMLElement | null;
    window.addEventListener('scroll', () => {
      if (!scene || manuallyToggled) return;
      const p = parseFloat(getComputedStyle(scene).getPropertyValue('--p')) || 0;
      setFractureState(p > 0.48);
    }, { passive: true });
  }
</script>

<style>
  .scene {
    height: 380vh;
    position: relative;
    --p: 0;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    background: radial-gradient(circle at 50% 50%, #1e1114 0%, #0a0607 100%);
    padding: calc(var(--hud-height, 68px) + 12px) 20px 16px;
    box-sizing: border-box;
    gap: 10px;
  }

  /* Uncollapsible Narrative Box */
  .narrative {
    position: relative;
    width: 100% !important;
    max-width: min(90vw, 740px) !important;
    min-height: 120px;
    margin: 0 auto !important;
    text-align: center !important;
    pointer-events: none;
    z-index: 5;
    flex-shrink: 0;
  }

  .scene-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: #e63946;
    display: inline-block;
    margin-bottom: 4px;
  }

  .scene-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 400;
    font-style: italic;
    color: #fff;
    margin: 0 0 8px;
    filter: url(#ink-displacement);
  }

  .beat-text {
    font-family: var(--font-editorial);
    font-size: clamp(0.92rem, 1.7vw, 1.05rem);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    margin: 0;
  }

  .shanks-quote {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.5vw, 1.7rem);
    font-style: italic;
    color: #e63946;
    line-height: 1.45;
    margin: 0;
  }

  .shanks-quote cite {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-style: normal;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 8px;
    letter-spacing: 0.05em;
  }

  /* Dome Stage: Compact, elegant, 100% visible */
  .dome-stage {
    position: relative;
    width: 100%;
    max-width: 740px;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 2px;
    z-index: 2;
  }

  .dome-display {
    width: 100%;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    background: rgba(18, 12, 14, 0.95) !important;
    border: 1px solid rgba(230, 57, 70, 0.35) !important;
  }

  .dome-svg-wrap {
    width: 100%;
    max-width: 320px;
    height: 110px;
    display: flex;
    justify-content: center;
  }

  .dome-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .dome-inspection {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .digits-sequence {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: var(--font-mono);
  }

  .d-valid {
    font-size: 1.05rem;
    color: #c59b27;
  }

  /* Fatal 528 Digit Button */
  .d-fatal {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding: 4px 12px;
    border: 1px solid rgba(197, 155, 39, 0.5);
    background: rgba(0, 0, 0, 0.6);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .fatal-index {
    font-size: 0.6rem;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.08em;
  }

  .fatal-digit {
    font-size: 1.6rem;
    color: #c59b27;
    line-height: 1.1;
    transition: all 0.3s ease;
  }

  .fatal-correct-hint {
    font-size: 0.58rem;
    color: #39ff88;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .d-fatal.is-error {
    border-color: #e63946;
    background: rgba(230, 57, 70, 0.25);
    box-shadow: 0 0 20px rgba(230, 57, 70, 0.5);
  }

  .d-fatal.is-error .fatal-digit {
    color: #e63946;
    text-shadow: 0 0 10px #e63946;
  }

  .d-fatal.is-error .fatal-correct-hint {
    opacity: 1;
  }

  /* Crumbling Ash Stream */
  .crumbling-ash-stream {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 1.05rem;
    color: #c59b27;
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ash-label {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-left: 6px;
  }

  .crumbling-ash-stream.is-fallen {
    transform: translateY(12px);
    opacity: 0.22;
    filter: grayscale(1) blur(1.5px);
  }

  .crumbling-ash-stream.is-fallen .d-crumb {
    color: #888;
  }

  .shanks-controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .shanks-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: 1px solid rgba(230, 57, 70, 0.5);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    padding: 6px 14px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .shanks-btn:hover {
    background: rgba(230, 57, 70, 0.2);
    border-color: #e63946;
    color: #e63946;
  }

  .shanks-btn-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #e63946;
    box-shadow: 0 0 6px #e63946;
  }

  .shanks-status-note {
    font-family: var(--font-editorial);
    font-size: 0.82rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.65);
    text-align: center;
    max-width: 580px;
  }

  @media (max-height: 750px) {
    .dome-svg-wrap {
      height: 80px;
    }
    .narrative {
      min-height: 95px;
    }
  }
</style>
