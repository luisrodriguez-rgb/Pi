---
import { MILESTONES } from '../../data/milestones';
import { type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const milestone = MILESTONES[3];
const vanCeulenDigits = '3.14159265358979323846264338327950288'.split('');
---

<section 
  id="scene-4" 
  class="scene" 
  data-scene="leiden" 
  data-year={milestone.year}
  data-pi-value={milestone.precisionValue}
  data-theme={milestone.theme}
  data-scene-title={milestone.title[locale]}
>
  <div class="stage">
    <!-- Crossed Fencing Rapiers fading as p increases -->
    <div class="fencing-swords">
      <div class="rapier rapier-left"></div>
      <div class="rapier rapier-right"></div>
    </div>

    <!-- Narrative Center (Uncollapsible, balanced typography positioned above slab) -->
    <div class="narrative">
      <div class="beat" data-beat="0.05-0.35">
        <span class="scene-kicker">04 // LEIDEN, 1610 d.C. · PAÍSES BAJOS</span>
        <h2 class="scene-title chiseled-title">{milestone.title[locale]}</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'El maestro de esgrima e ingeniería militar Ludolph van Ceulen dedicó la mayor parte de su vida a un duelo implacable contra el infinito: un polígono de 2⁶² lados (más de cuatro trillones de caras). A mano limpia, sin calculadoras, obtuvo 35 cifras exactas.'
            : 'Fencing and military engineering master Ludolph van Ceulen dedicated the greater part of his life to a relentless duel against infinity: a 2⁶²-sided polygon (over four trillion facets). By hand alone, with zero mechanical aids, he attained 35 exact figures.'}
        </p>
      </div>

      <div class="beat" data-beat="0.40-0.80">
        <span class="scene-kicker">04 // EL CINCEL EN LA PIEDRA NEGRA</span>
        <h2 class="scene-title">El Epitafio de la Iglesia de San Pedro</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'Estaba tan orgulloso de su sacrificio que ordenó en su testamento que aquellos 35 números fueran cincelados sobre su lápida sepulcral en la Pieterskerk de Leiden. Mueve el ratón para iluminar la piedra con tu vela.'
            : 'He took such fierce pride in his sacrifice that he ordered in his final will that those 35 numbers be chiseled upon his tombstone in the Pieterskerk of Leiden. Move your cursor to light the dark stone with your candle.'}
        </p>
      </div>

      <div class="beat beat-climax" data-beat="0.84-0.98">
        <blockquote class="tomb-latin-quote">
          <p>«Qui in vita sua multum laboravit...»</p>
          <cite>«Quien en su vida trabajó incansablemente midiendo el círculo.» — Lápida de Van Ceulen</cite>
        </blockquote>
      </div>
    </div>

    <!-- The Ancient Tombstone Monument with Candlelight Physics -->
    <div class="tombstone-wrapper">
      <!-- Museum Catalog Technical Plate (In-Flow, Zero HUD Overlap) -->
      <div class="museum-plate">
        [ FIG. 04 // LEIDEN, 1610 — LOSA PIETERSKERK — ESCALA 1:1 — PRECISIÓN: 10⁻³⁵ ]
      </div>

      <div class="tombstone-slab" id="tombstone-slab">
        <!-- Authentic Chiseled Flemish Stone Texture Overlay -->
        <div class="slab-stone-texture" aria-hidden="true"></div>

        <!-- Candlelight Torch Glow Layer -->
        <div class="candlelight-glow" id="candlelight-layer"></div>

        <div class="slab-arch">
          <span class="cross-ornament">✠</span>
          <span class="slab-heading">LUDOLPHUS VAN CEULEN</span>
          <span class="slab-subheading">MAGISTER ARTIUM ATQUE GLADIATORI</span>
        </div>

      <div class="slab-divider"></div>

      <!-- The 35 Chiseled Digits Grid with Dynamic Shadow Projection -->
      <div class="chiseled-grid">
        {vanCeulenDigits.map((char, index) => {
          const threshold = 0.15 + (index / vanCeulenDigits.length) * 0.70;
          return (
            <span 
              class={`chiseled-glyph ${char === '.' ? 'dot-glyph' : ''}`}
              data-threshold={threshold.toFixed(3)}
            >
              {char}
            </span>
          );
        })}
      </div>

      <div class="slab-footer">
        <span class="slab-counter-label">DÍGITOS CINCELADOS EN LA CRIPTA:</span>
        <strong id="chiseled-count" class="slab-counter-num tabular">0 / 35</strong>
      </div>
    </div>
  </div>
</div>
</section>

<script>
  import { soundEngine } from '../../scripts/audio';

  const slab = document.getElementById('tombstone-slab');
  const countEl = document.getElementById('chiseled-count');

  if (slab) {
    const glyphs = slab.querySelectorAll<HTMLElement>('.chiseled-glyph');
    const scene = slab.closest('[data-scene]') as HTMLElement | null;
    let lastChiseled = 0;

    function updateTombstone() {
      if (!scene) return;
      const p = parseFloat(getComputedStyle(scene).getPropertyValue('--p')) || 0;

      let activeCount = 0;
      glyphs.forEach((glyph) => {
        const threshold = parseFloat(glyph.dataset.threshold || '0');
        const isChiseled = p >= threshold;
        glyph.classList.toggle('is-chiseled', isChiseled);
        if (isChiseled && glyph.textContent !== '.') activeCount++;
      });

      if (countEl) countEl.textContent = `${activeCount} / 35`;

      if (Math.floor(activeCount / 5) > Math.floor(lastChiseled / 5)) {
        soundEngine.playChisel();
      }
      lastChiseled = activeCount;
    }

    window.addEventListener('scroll', updateTombstone, { passive: true });
    updateTombstone();

    // ==========================================================
    // Micro-UX: Directional Candlelight / Torchlight Physics
    // ==========================================================
    slab.addEventListener('mousemove', (e) => {
      const rect = slab.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      slab.style.setProperty('--mouse-x', `${x}px`);
      slab.style.setProperty('--mouse-y', `${y}px`);

      // Dynamic shadow projection: vector from mouse to slab center
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const dx = (centerX - x) * 0.08;
      const dy = (centerY - y) * 0.08;

      glyphs.forEach((glyph) => {
        if (glyph.classList.contains('is-chiseled')) {
          glyph.style.textShadow = `${dx.toFixed(1)}px ${dy.toFixed(1)}px 8px rgba(0,0,0,0.95), 0 0 10px rgba(230,194,128,0.5)`;
        }
      });
    });
  }
</script>

<style>
  .scene {
    height: 380vh;
    position: relative;
    --p: 0;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    background: radial-gradient(circle at 50% 50%, #17191e 0%, #08090b 100%);
    padding: calc(var(--hud-height, 68px) + 12px) 20px 16px;
    box-sizing: border-box;
    gap: 8px;
  }

  /* Crossed Fencing Rapiers */
  .fencing-swords {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: calc(clamp(0, 1 - var(--p) * 2.5, 0.4));
    transition: opacity 0.3s ease;
  }

  .rapier {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2px;
    height: 280px;
    background: linear-gradient(180deg, #e6c280 0%, rgba(230, 194, 128, 0.1) 100%);
    box-shadow: 0 0 10px rgba(230, 194, 128, 0.3);
  }

  .rapier-left {
    transform: translate(-50%, -50%) rotate(-40deg);
  }

  .rapier-right {
    transform: translate(-50%, -50%) rotate(40deg);
  }

  .tombstone-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 580px;
    margin-top: 4px;
    z-index: 2;
  }

  /* Non-overlapping Narrative Box Positioned Above Tombstone */
  .narrative {
    position: relative;
    width: 100% !important;
    max-width: min(90vw, 740px) !important;
    min-height: 110px;
    margin: 0 auto !important;
    text-align: center !important;
    pointer-events: none;
    z-index: 5;
    flex-shrink: 0;
  }

  .beat {
    opacity: 0;
    transform: translate3d(0, 14px, 0);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    width: 100% !important;
  }

  .beat.is-active {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    pointer-events: auto;
    position: relative;
  }

  .scene-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: #e6c280;
    display: inline-block;
    margin-bottom: 6px;
  }

  .scene-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.8vw, 2.8rem);
    font-weight: 400;
    color: #fff;
    margin: 0 0 10px;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.9);
  }

  .beat-text {
    font-family: var(--font-editorial);
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.65;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
  }

  .tomb-latin-quote {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.8vw, 1.9rem);
    font-style: italic;
    color: #e6c280;
    line-height: 1.5;
    margin: 0;
    text-shadow: 0 0 25px rgba(230, 194, 128, 0.4);
  }

  .tomb-latin-quote cite {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-style: normal;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 10px;
    letter-spacing: 0.05em;
  }

  /* Dark Flemish Slate Tombstone with Authentic Stone Texture & Candlelight Physics */
  .tombstone-slab {
    position: relative;
    margin-top: 0;
    width: min(90vw, 560px);
    background: #111317;
    background-image: 
      radial-gradient(circle 380px at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(230, 194, 128, 0.16) 0%, transparent 100%),
      radial-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(180deg, #181b21 0%, #0c0e12 100%);
    background-size: 100% 100%, 16px 16px, 100% 100%;
    border: 1px solid rgba(230, 194, 128, 0.35);
    border-radius: 40px 40px 0 0;
    padding: 26px 26px 20px;
    box-shadow: 
      0 30px 80px rgba(0, 0, 0, 0.95),
      inset 0 1px 0 rgba(230, 194, 128, 0.3);
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
    cursor: grab;
    overflow: hidden;
  }

  .slab-stone-texture {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: url('/images/tombstone-texture.jpg');
    background-size: cover;
    background-position: center;
    mix-blend-mode: overlay;
    opacity: 0.36;
    pointer-events: none;
    z-index: 1;
  }

  .candlelight-glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(circle 280px at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(230, 194, 128, 0.08) 0%, transparent 70%);
  }

  .slab-arch {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-bottom: 10px;
  }

  .cross-ornament {
    font-size: 1.2rem;
    color: #e6c280;
  }

  .slab-heading {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.15em;
    color: #f0ebe1;
  }

  .slab-subheading {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: rgba(230, 194, 128, 0.7);
  }

  .slab-divider {
    width: 60px;
    height: 1px;
    background: rgba(230, 194, 128, 0.3);
    margin: 8px 0 14px;
  }

  .chiseled-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px 8px;
    max-width: 480px;
    padding: 16px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--grid-line);
  }

  .chiseled-glyph {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.5vw, 1.4rem);
    font-weight: 600;
    font-variant-numeric: tabular-nums slashed-zero;
    width: 24px;
    height: 32px;
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.08);
    transform: scale(0.92);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dot-glyph {
    width: 12px;
  }

  .chiseled-glyph.is-chiseled {
    color: #e6c280;
    transform: scale(1);
    text-shadow: 
      0 0 12px rgba(230, 194, 128, 0.6),
      0 2px 4px rgba(0, 0, 0, 0.9);
  }

  .slab-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .slab-counter-label {
    color: var(--muted);
    letter-spacing: 0.08em;
  }

  .slab-counter-num {
    color: #e6c280;
  }
</style>
