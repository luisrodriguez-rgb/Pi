---
import { MILESTONES } from '../../data/milestones';
import { type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const milestone = MILESTONES[3];
const vanCeulenDigits = '3.14159265358979323846264338327950288'.split('');
---

<section 
  id="scene-4" 
  class="scene" 
  data-scene="tombstone" 
  data-year={milestone.year}
  data-pi-value={milestone.piApproximation}
  data-theme={milestone.theme}
  data-scene-title={milestone.title[locale]}
>
  <div class="stage">
    <!-- Narrative beats -->
    <div class="narrative">
      <div class="beat" data-beat="0.05-0.35">
        <span class="scene-kicker">04 // LEIDEN, 1610 d.C.</span>
        <h2 class="scene-title">{milestone.title[locale]}</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'El matemático germano-holandés Ludolph van Ceulen dedicó la mayor parte de su vida a llevar el método poligonal de Arquímedes hasta el límite absoluto: un polígono monstruoso de 2⁶² lados (4,611,686,018,427,387,904 lados).'
            : 'German-Dutch mathematician Ludolph van Ceulen spent the bulk of his life pushing Archimedes’ exhaustion method to its outer limit: a monstrous polygon of 2⁶² sides (4,611,686,018,427,387,904 sides).'}
        </p>
      </div>

      <div class="beat" data-beat="0.40-0.95">
        <span class="scene-kicker">04 // EL EPITAFIO DE PI</span>
        <h2 class="scene-title">Cincelado en la Piedra de San Pedro</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'A mano limpia, sin calculadoras, obtuvo 35 cifras decimales exactas. Estaba tan orgulloso de su hazaña que ordenó en su testamento que estos 35 números fueran cincelados sobre su lápida sepulcral.'
            : 'By hand, with zero mechanical aids, he attained 35 exact decimal digits. He was so proud of this feat that he dictated in his will that all 35 numbers be engraved upon his tombstone.'}
        </p>
      </div>
    </div>

    <!-- The Ancient Tombstone Monument -->
    <div class="tombstone-slab" id="tombstone-slab">
      <div class="slab-arch">
        <span class="cross-ornament">✠</span>
        <span class="slab-heading">LUDOLPHUS VAN CEULEN</span>
        <span class="slab-subheading">ANNO DOMINI MDCX</span>
      </div>

      <div class="slab-divider"></div>

      <!-- The 35 Chiseled Digits Grid -->
      <div class="chiseled-grid">
        {vanCeulenDigits.map((char, index) => {
          // Normalize threshold 0.15 to 0.85
          const threshold = 0.15 + (index / vanCeulenDigits.length) * 0.70;
          return (
            <span 
              class={`chiseled-glyph ${char === '.' ? 'dot-glyph' : ''}`}
              data-threshold={threshold.toFixed(3)}
              style={`--threshold: ${threshold.toFixed(3)};`}
            >
              {char}
            </span>
          );
        })}
      </div>

      <div class="slab-footer">
        <span class="slab-counter-label">DÍGITOS CINCELADOS:</span>
        <strong id="chiseled-count" class="slab-counter-num">0 / 35</strong>
      </div>
    </div>
  </div>
</section>

<script>
  import { soundEngine } from '../../scripts/audio';

  const slab = document.getElementById('tombstone-slab');
  const countEl = document.getElementById('chiseled-count');

  if (slab) {
    const glyphs = slab.querySelectorAll<HTMLElement>('.chiseled-glyph');
    const scene = slab.closest('[data-scene]') as HTMLElement | null;
    let lastChiseled = 0;

    function updateTombstone() {
      if (!scene) return;
      const p = parseFloat(getComputedStyle(scene).getPropertyValue('--p')) || 0;

      let activeCount = 0;
      glyphs.forEach((glyph) => {
        const threshold = parseFloat(glyph.dataset.threshold || '0');
        const isChiseled = p >= threshold;
        glyph.classList.toggle('is-chiseled', isChiseled);
        if (isChiseled && glyph.textContent !== '.') activeCount++;
      });

      if (countEl) countEl.textContent = `${activeCount} / 35`;

      // Play chisel sound when a new batch of 5 digits is engraved
      if (Math.floor(activeCount / 5) > Math.floor(lastChiseled / 5)) {
        soundEngine.playChisel();
      }
      lastChiseled = activeCount;
    }

    window.addEventListener('scroll', updateTombstone, { passive: true });
    updateTombstone();
  }
</script>

<style>
  .scene {
    height: 380vh;
    position: relative;
    --p: 0;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: radial-gradient(circle at 50% 50%, #17171e 0%, #0a0a0d 100%);
    padding: 0 20px;
  }

  .narrative {
    position: absolute;
    top: 11vh;
    max-width: 660px;
    text-align: center;
    pointer-events: none;
    z-index: 5;
  }

  .beat {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
  }

  .beat.is-active {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    pointer-events: auto;
  }

  .scene-kicker {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: #e2b714;
    display: inline-block;
    margin-bottom: 6px;
  }

  .scene-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 400;
    color: #fff;
    margin: 0 0 10px;
  }

  .beat-text {
    font-family: var(--font-sans);
    font-size: clamp(0.9rem, 1.6vw, 1.05rem);
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.5;
    margin: 0;
  }

  /* Dark Granite Stone Tombstone Monument */
  .tombstone-slab {
    position: relative;
    margin-top: 18vh;
    width: min(90vw, 540px);
    background: #14161b;
    background-image: 
      radial-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(180deg, #1d2026 0%, #111317 100%);
    background-size: 16px 16px, 100% 100%;
    border: 2px solid rgba(255, 255, 255, 0.12);
    border-radius: 40px 40px 12px 12px;
    padding: 32px 30px 24px;
    box-shadow: 
      0 30px 80px rgba(0, 0, 0, 0.9),
      inset 0 2px 4px rgba(255, 255, 255, 0.1),
      inset 0 -4px 12px rgba(0, 0, 0, 0.6);
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
  }

  .slab-arch {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-bottom: 12px;
  }

  .cross-ornament {
    font-size: 1.2rem;
    color: rgba(212, 175, 55, 0.6);
  }

  .slab-heading {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    letter-spacing: 0.15em;
    color: #f0ebe1;
  }

  .slab-subheading {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    color: rgba(212, 175, 55, 0.7);
  }

  .slab-divider {
    width: 60px;
    height: 1px;
    background: rgba(212, 175, 55, 0.3);
    margin: 8px 0 16px;
  }

  /* The Chiseled Digits */
  .chiseled-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px 8px;
    max-width: 460px;
    padding: 16px;
    background: rgba(0, 0, 0, 0.35);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .chiseled-glyph {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.5vw, 1.4rem);
    font-weight: 600;
    width: 24px;
    height: 32px;
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.08);
    transform: scale(0.92);
    transition: 
      color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      text-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dot-glyph {
    width: 12px;
  }

  /* Chiseled state: illuminated gold engraving */
  .chiseled-glyph.is-chiseled {
    color: #ffd700;
    transform: scale(1);
    text-shadow: 
      0 0 10px rgba(255, 215, 0, 0.6),
      0 2px 4px rgba(0, 0, 0, 0.9);
  }

  .slab-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .slab-counter-label {
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.08em;
  }

  .slab-counter-num {
    color: #ffd700;
  }
</style>
