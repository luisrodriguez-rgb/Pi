---
import { MILESTONES } from '../../data/milestones';
import SceneVideo from '../SceneVideo.astro';
import { type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const milestone = MILESTONES[3];
const vanCeulenDigits = '3.14159265358979323846264338327950288'.split('');
---

<section 
  id="scene-4" 
  class="scene" 
  data-scene="leiden" 
  data-year={milestone.year}
  data-pi-value={milestone.precisionValue}
  data-theme={milestone.theme}
  data-scene-title={milestone.title[locale]}
>
  <div class="stage">
    <!-- Cinematic Atmospheric Video Background (Google Flow / Veo) -->
    <SceneVideo 
      src="/videos/04-leiden.mp4" 
      poster="/images/04-leiden.jpg" 
      blend="screen" 
      focalPoint="center 50%" 
      opacity={0.72} 
    />

    <!-- Crossed Fencing Rapiers fading as p increases -->
    <div class="fencing-swords">
      <div class="rapier rapier-left"></div>
      <div class="rapier rapier-right"></div>
    </div>

    <!-- Inner Content: Split Architecture (Narrative Left, Chiseled Gravestone Right) -->
    <div class="stage-content layout-split">
      <div class="narrative-left choreo-header">
        <!-- Museum Catalog Technical Plate -->
        <div class="museum-plate">
          [ FIG. 04 // LEIDEN, 1610 — LOSA PIETERSKERK — ESCALA 1:1 — PRECISIÓN: 10⁻³⁵ ]
        </div>

        <div class="narrative-layer">
          <div class="beat beat-1" data-beat="0.00-0.40">
            <span class="scene-kicker">04 // LEIDEN, 1610 d.C. · PAÍSES BAJOS</span>
            <h2 class="scene-title chiseled-title">{milestone.title[locale]}</h2>
            <p class="beat-text">
              {locale === 'es'
                ? 'El maestro de esgrima e ingeniería militar Ludolph van Ceulen dedicó la mayor parte de su vida a un duelo implacable contra el infinito: un polígono de 2⁶² lados (más de cuatro trillones de caras). A mano limpia, sin calculadoras, obtuvo 35 cifras exactas.'
                : 'Fencing and military engineering master Ludolph van Ceulen dedicated the greater part of his life to a relentless duel against infinity: a 2⁶²-sided polygon (over four trillion facets). By hand alone, with zero mechanical aids, he attained 35 exact figures.'}
            </p>
          </div>

          <div class="beat beat-2" data-beat="0.38-0.78">
            <span class="scene-kicker">04 // EL CINCEL EN LA PIEDRA NEGRA</span>
            <h2 class="scene-title">El Epitafio de la Iglesia de San Pedro</h2>
            <p class="beat-text">
              {locale === 'es'
                ? 'Estaba tan orgulloso de su sacrificio que ordenó en su testamento que aquellos 35 números fueran cincelados sobre su lápida sepulcral en la Pieterskerk de Leiden. Conforme avanzas, el cincel graba cada cifra en pan de oro sobre la piedra.'
                : 'He took such fierce pride in his sacrifice that he ordered in his final will that those 35 numbers be chiseled upon his tombstone in the Pieterskerk of Leiden. As you scroll, each digit is struck in gold leaf directly into the stone.'}
            </p>
          </div>

          <div class="beat beat-climax" data-beat="0.75-1.00">
            <blockquote class="tomb-latin-quote">
              <p>«Qui in vita sua multum laboravit...»</p>
              <cite>«Quien en su vida trabajó incansablemente midiendo el círculo.» — Lápida de Van Ceulen</cite>
            </blockquote>
          </div>
        </div>
      </div>

      <!-- Right Column: 35 Chiseled Digits Floating Directly on the Real Video Stone -->
      <div class="tombstone-direct-stone choreo-artifact" id="tombstone-slab">
        <div class="slab-arch">
          <span class="cross-ornament">✠</span>
          <span class="slab-heading">LUDOLPHUS VAN CEULEN</span>
          <span class="slab-subheading">MAGISTER ARTIUM ATQUE GLADIATORI</span>
        </div>

        <div class="slab-divider"></div>

        <!-- The 35 Chiseled Digits Grid Floating Directly on Stone -->
        <div class="chiseled-grid">
          {vanCeulenDigits.map((char, index) => {
            const threshold = 0.15 + (index / vanCeulenDigits.length) * 0.70;
            return (
              <span 
                class={`chiseled-glyph ${char === '.' ? 'dot-glyph' : ''}`}
                data-threshold={threshold.toFixed(3)}
              >
                {char}
              </span>
            );
          })}
        </div>

        <div class="slab-footer choreo-metrics">
          <span class="slab-counter-label">DÍGITOS CINCELADOS EN LA CRIPTA:</span>
          <strong id="chiseled-count" class="slab-counter-num tabular">0 / 35</strong>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { soundEngine } from '../../scripts/audio';

  const slab = document.getElementById('tombstone-slab');
  const countEl = document.getElementById('chiseled-count');

  if (slab) {
    const glyphs = slab.querySelectorAll<HTMLElement>('.chiseled-glyph');
    const scene = slab.closest('[data-scene]') as HTMLElement | null;
    let lastChiseled = 0;

    function updateTombstone() {
      if (!scene) return;
      const p = parseFloat(getComputedStyle(scene).getPropertyValue('--p')) || 0;

      let activeCount = 0;
      glyphs.forEach((glyph) => {
        const threshold = parseFloat(glyph.dataset.threshold || '0');
        const isChiseled = p >= threshold;
        glyph.classList.toggle('is-chiseled', isChiseled);
        if (isChiseled && glyph.textContent !== '.') activeCount++;
      });

      if (countEl) countEl.textContent = `${activeCount} / 35`;

      if (Math.floor(activeCount / 5) > Math.floor(lastChiseled / 5)) {
        soundEngine.playChisel();
      }
      lastChiseled = activeCount;
    }

    window.addEventListener('scroll', updateTombstone, { passive: true });
    updateTombstone();
  }
</script>

<style>
  .scene {
    height: 380vh;
    position: relative;
    --p: 0;
  }

  .stage {
    background: radial-gradient(circle at 50% 50%, #17191e 0%, #08090b 100%);
  }

  /* Crossed Fencing Rapiers */
  .fencing-swords {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: calc(clamp(0, 1 - var(--p) * 2.5, 0.4));
    transition: opacity 0.3s ease;
  }

  .rapier {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2px;
    height: 280px;
    background: linear-gradient(180deg, #e6c280 0%, rgba(230, 194, 128, 0.1) 100%);
    box-shadow: 0 0 10px rgba(230, 194, 128, 0.3);
  }

  .rapier-left {
    transform: translate(-50%, -50%) rotate(-40deg);
  }

  .rapier-right {
    transform: translate(-50%, -50%) rotate(40deg);
  }

  .narrative-left {
    position: relative;
    width: 100%;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .scene-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: #e6c280;
    display: inline-block;
    margin-bottom: 6px;
  }

  .scene-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.8vw, 2.8rem);
    font-weight: 400;
    color: #fff;
    margin: 0 0 10px;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.9);
  }

  .beat-text {
    font-family: var(--font-editorial);
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.65;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
  }

  .tomb-latin-quote {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.8vw, 1.9rem);
    font-style: italic;
    color: #e6c280;
    line-height: 1.5;
    margin: 0;
    text-shadow: 0 0 25px rgba(230, 194, 128, 0.4);
  }

  .tomb-latin-quote cite {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-style: normal;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 10px;
    letter-spacing: 0.05em;
  }

  /* Chiseled Inscription Floating Directly on Video's Real Stone */
  .tombstone-direct-stone {
    position: relative;
    width: 100%;
    max-width: 520px;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 5;
    padding: 10px 0;
  }

  .slab-arch {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-bottom: 12px;
  }

  .cross-ornament {
    font-size: 1.4rem;
    color: #e5b94c;
    text-shadow: 0 0 16px rgba(229, 185, 76, 0.6);
  }

  .slab-heading {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.16em;
    color: #f7f3ea;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.9);
  }

  .slab-subheading {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    color: #e5b94c;
    text-transform: uppercase;
  }

  .slab-divider {
    width: 80px;
    height: 1px;
    background: linear-gradient(90deg, transparent, #e5b94c, transparent);
    margin: 8px 0 16px;
  }

  .chiseled-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px 10px;
    max-width: 480px;
    padding: 10px 0;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }

  .chiseled-glyph {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums slashed-zero;
    width: 32px;
    height: 38px;
    display: grid;
    place-items: center;
    color: rgba(229, 185, 76, 0.25);
    transform: scale(0.92);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.95);
  }

  .dot-glyph {
    width: 14px;
  }

  .chiseled-glyph.is-chiseled {
    color: #ffd700 !important;
    transform: scale(1.15);
    text-shadow: 
      0 0 18px rgba(255, 215, 0, 0.85),
      0 0 36px rgba(229, 185, 76, 0.45),
      0 2px 6px rgba(0, 0, 0, 0.95) !important;
  }

  .slab-footer {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    background: rgba(0, 0, 0, 0.55);
    padding: 6px 14px;
    border: 1px solid rgba(229, 185, 76, 0.3);
  }

  .slab-counter-label {
    color: #a3a3a3;
    letter-spacing: 0.08em;
  }

  .slab-counter-num {
    color: #ffd700;
    font-weight: 700;
  }
</style>
