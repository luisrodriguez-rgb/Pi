---
import { MILESTONES } from '../../data/milestones';
import { UI_STRINGS, type Locale } from '../../i18n';
import RhindArtifact from '../RhindArtifact.astro';
import SceneVideo from '../SceneVideo.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const milestone = MILESTONES[0];
const t = UI_STRINGS[locale];
---

<section 
  id="scene-1" 
  class="scene" 
  data-scene="rhind" 
  data-year={milestone.year}
  data-pi-value={milestone.precisionValue}
  data-theme={milestone.theme}
  data-scene-title={milestone.title[locale]}
>
  <div class="stage">
    <!-- Cinematic Atmospheric Video Background (Google Flow / Veo) -->
    <SceneVideo 
      src="/videos/01-egypt.mp4" 
      poster="/images/01-egypt.jpg" 
      blend="lighten" 
      opacity={0.55} 
    />

    <!-- 2-Column Responsive Layout (DSKY Midudev Philosophy) -->
    <div class="stage-layout">
      <!-- Left Column: Narrative Layer & Historical Beats -->
      <div class="narrative-col choreo-header">
        <div class="narrative-layer">
          <!-- Beat 1: Initial Hook -->
          <div class="beat beat-1" data-beat="0.00-0.32">
            <span class="scene-kicker">01 // TEBAS, 1650 a.C. · EGIPTO</span>
            <h1 class="hero-title">{milestone.title[locale]}</h1>
            <p class="hero-desc">
              {locale === 'es'
                ? 'En las orillas del Nilo, el escriba real Ahmes toma una cuerda de cáñamo con dos estacas. Para calcular la cebada que cabe en los graneros cilíndricos del Faraón, clava una punta en la arena y hace girar la otra.'
                : 'Upon the banks of the Nile, royal scribe Ahmes grips a hemp rope tied between two stakes. To measure the barley within the Pharaoh’s cylindrical granaries, he pins one stake into the sand and sweeps the other.'}
            </p>
            <div class="scroll-cue">
              <span class="mouse-icon"></span>
              <span class="cue-text">{t.scrollPrompt}</span>
            </div>
          </div>

          <!-- Beat 2: Rhind Papyrus Emergence -->
          <div class="beat beat-2" data-beat="0.36-0.72">
            <span class="scene-kicker">01 // EL PAPIRO DE RHIND (PROBLEMA 48)</span>
            <h2 class="scene-title">«Quita 1/9 del diámetro»</h2>
            <p class="hero-desc">
              {locale === 'es'
                ? '«Corta un noveno del diámetro y construye un cuadrado con el resto: su área será casi igual a la del círculo». Sin saberlo, Ahmes acaba de aproximar la constante más misteriosa del cosmos a (16/9)².'
                : '«Take away 1/9 of the diameter and construct a square upon the remainder: its area shall equal the circle». Without knowing it, Ahmes approximated the cosmos’s deepest constant to (16/9)².'}
            </p>
            <!-- Blueprint Technical Pill (Zero SaaS border-radius) -->
            <div class="formula-blueprint blueprint-panel choreo-metrics">
              <span class="pill-formula">π ≈ (16/9)² = 256/81</span>
              <strong class="pill-val tabular">3.16049</strong>
            </div>
          </div>

          <!-- Beat 3: Culmination of Egypt -->
          <div class="beat beat-3" data-beat="0.76-0.98">
            <blockquote class="climax-quote">
              <p>«Por primera vez en la historia, la humanidad intenta atrapar una curva perfecta dentro de líneas rectas.»</p>
              <cite>— Papiro Matemático de Rhind (Museo Británico)</cite>
            </blockquote>
          </div>
        </div>
      </div>

      <!-- Right Column: Artifact Visualizer & Hemp Rope Compass -->
      <div class="artifact-col choreo-artifact">
        <!-- Museum Catalog Technical Plate (In-Flow, Zero Collisions) -->
        <div class="museum-plate">
          [ FIG. 01 // TEBAS, 1650 a.C. — PAPIRO DE RHIND — PROBLEMA 48 ]
        </div>

        <div class="artifact-card blueprint-panel">
          <RhindArtifact />

          <!-- Dynamic Hemp Rope Scribe Compass Overlaid Directly on Artifact -->
          <div class="rope-compass-overlay">
            <svg viewBox="0 0 400 400" class="compass-svg">
              <!-- Center Pivot Pin -->
              <circle cx="200" cy="200" r="5" fill="#f4a261" stroke="#3d2314" stroke-width="2" />
              <!-- Rotating Tensed Hemp Rope -->
              <g class="rope-arm">
                <line x1="200" y1="200" x2="335" y2="200" stroke="#c29b62" stroke-width="3" stroke-dasharray="3,2" stroke-linecap="round" />
                <circle cx="335" cy="200" r="4.5" fill="#d94e28" stroke="#fff" stroke-width="1.5" />
              </g>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .scene {
    height: 380vh;
    position: relative;
    --p: 0;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: radial-gradient(circle at 50% 50%, #1e1510 0%, #0d0a08 100%);
    padding: calc(var(--hud-height, 68px) + 16px) 24px 24px;
    box-sizing: border-box;
  }

  /* Papyrus Background Texture */
  .papyrus-ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .papyrus-photo-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.18;
    mix-blend-mode: luminosity;
  }

  /* Two-column responsive blueprint grid */
  .stage-layout {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 28px;
    width: 100%;
    max-width: 1100px;
    position: relative;
    z-index: 5;
    margin: 0 auto;
  }

  @media (min-width: 900px) {
    .stage-layout {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 48px;
    }
  }

  /* Left Column: Narrative Layer */
  .narrative-col {
    position: relative;
    width: 100%;
    min-height: 260px;
    display: flex;
    align-items: center;
  }

  .narrative-layer {
    position: relative;
    width: 100%;
  }

  .beat {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    pointer-events: none;
  }

  .beat.is-active {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    pointer-events: auto;
    position: relative;
  }

  .scene-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--accent);
    display: inline-block;
    margin-bottom: 8px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
    font-weight: 400;
    font-style: italic;
    color: var(--fg-ink);
    margin: 0 0 14px;
    line-height: 1.12;
    filter: url(#ink-displacement);
  }

  .scene-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    font-weight: 400;
    font-style: italic;
    color: var(--fg-ink);
    margin: 0 0 14px;
    filter: url(#ink-displacement);
  }

  .hero-desc {
    font-family: var(--font-editorial);
    font-size: clamp(1.02rem, 1.9vw, 1.18rem);
    color: color-mix(in srgb, var(--fg-ink) 85%, transparent);
    line-height: 1.65;
    margin: 0 0 20px;
  }

  .scroll-cue {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.08em;
  }

  .mouse-icon {
    width: 14px;
    height: 22px;
    border: 1px solid var(--accent);
    border-radius: 8px;
    position: relative;
  }

  .mouse-icon::after {
    content: '';
    position: absolute;
    top: 4px;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: 4px;
    background: var(--accent);
    border-radius: 1px;
    animation: mouseWheel 1.5s infinite;
  }

  @keyframes mouseWheel {
    0% { opacity: 1; transform: translate(-50%, 0); }
    100% { opacity: 0; transform: translate(-50%, 8px); }
  }

  /* Formula Technical Blueprint Box */
  .formula-blueprint {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 10px 18px;
    border: 1px solid var(--grid-line);
    background: color-mix(in srgb, var(--bg-surface) 90%, transparent);
  }

  .pill-formula {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-ink);
  }

  .pill-val {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--accent);
    font-weight: 700;
  }

  .climax-quote {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 1.8rem);
    font-style: italic;
    color: var(--accent);
    line-height: 1.45;
    margin: 0;
    border-left: 2px solid var(--accent);
    padding-left: 16px;
  }

  .climax-quote cite {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-style: normal;
    color: var(--muted);
    margin-top: 10px;
    letter-spacing: 0.08em;
  }

  /* Right Column: Artifact & Compass */
  .artifact-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .artifact-card {
    width: 100%;
    max-width: 400px;
    position: relative;
    padding: 16px;
    background: rgba(26, 20, 14, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1px solid var(--grid-line);
  }

  .rope-compass-overlay {
    position: absolute;
    inset: 16px;
    pointer-events: none;
  }

  .compass-svg {
    width: 100%;
    height: 100%;
  }

  .rope-arm {
    transform-origin: 200px 200px;
    opacity: clamp(0, calc((var(--p, 0) - 0.20) * 8), 1);
    transform: rotate(calc(clamp(0, calc((var(--p, 0) - 0.25) * 1.666), 1) * 360deg));
    will-change: transform, opacity;
    transition: transform 0.08s linear;
  }

  @media (max-width: 899px) {
    .artifact-col {
      display: none;
    }
    .narrative-col {
      text-align: center;
    }
    .climax-quote {
      border-left: none;
      padding-left: 0;
    }
  }
</style>

<script>
  // Simple beat progress switcher for Scene 1
  function updateScene1Beats() {
    const scene = document.getElementById('scene-1');
    if (!scene) return;
    const rect = scene.getBoundingClientRect();
    const progress = Math.min(1, Math.max(0, -rect.top / (rect.height - window.innerHeight)));
    
    scene.style.setProperty('--p', progress.toFixed(4));

    const beats = scene.querySelectorAll<HTMLElement>('.beat');
    beats.forEach(beat => {
      const range = beat.dataset.beat?.split('-').map(Number) || [0, 1];
      if (progress >= range[0] && progress <= range[1]) {
        beat.classList.add('is-active');
      } else {
        beat.classList.remove('is-active');
      }
    });
  }

  window.addEventListener('scroll', updateScene1Beats, { passive: true });
  updateScene1Beats();
</script>
