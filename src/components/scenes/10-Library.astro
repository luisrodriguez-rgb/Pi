---
import { MILESTONES } from '../../data/milestones';
import SceneVideo from '../SceneVideo.astro';
import { UI_STRINGS, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const milestone = MILESTONES[9];
const t = UI_STRINGS[locale];
---

<section 
  id="scene-10" 
  class="scene" 
  data-scene="infinity" 
  data-year={milestone.year}
  data-pi-value={milestone.precisionValue}
  data-theme="infinite"
  data-scene-title={milestone.title[locale]}
>
  <div class="stage layout-split" id="scene-10-stage">
    <!-- Cinematic Atmospheric Video Background (Alabaster White & Klein Blue Infinite Horizon) -->
    <SceneVideo 
      src="/videos/10-horizon.mp4" 
      poster="/images/10-horizon.jpg" 
      blend="normal" 
      opacity={0.85} 
    />

    <!-- Cosmic Starfield Blackout Overlay as p -> 1.0 -->
    <div class="cosmos-starfield-fade" aria-hidden="true"></div>

    <!-- Cosmic Digits Earthrise Curvature Backdrop -->
    <div class="earthrise-curvature" aria-hidden="true">
      <svg viewBox="0 0 1000 400" class="curvature-svg" preserveAspectRatio="none">
        <defs>
          <radialGradient id="earth-glow" cx="50%" cy="100%" r="70%">
            <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.25" />
            <stop offset="70%" stop-color="var(--muted)" stop-opacity="0.08" />
            <stop offset="100%" stop-color="transparent" stop-opacity="0" />
          </radialGradient>
        </defs>
        <path d="M -100,400 Q 500,160 1100,400" fill="url(#earth-glow)" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="3,3" opacity="0.6"/>
      </svg>
    </div>

    <!-- Left Column: Narrative & Final Cosmic Reveal -->
    <div class="library-narrative-col choreo-header">
      <div class="museum-plate">
        [ FIG. 10 // COSMOS, PRESENTE — CHUDNOVSKY // 105 BILLONES DE DÍGITOS ]
      </div>

      <div class="beat" data-beat="0.05-0.35">
        <span class="scene-kicker">10 // EL HORIZONTE DEL INFINITO · PRESENTE</span>
        <h2 class="scene-title">{milestone.title[locale]}</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'Desde los cálculos de Emma Haruka Iwao en la nube hasta los récords actuales con el algoritmo Chudnovsky (más de 105 billones de decimales calculados), la humanidad ha empujado la frontera como nunca antes.'
            : 'From Emma Haruka Iwao’s cloud computations to modern records with the Chudnovsky algorithm (over 105 trillion decimals computed), humanity has driven the frontier into unfathomable depths.'}
        </p>
      </div>

      <div class="beat" data-beat="0.38-0.75">
        <span class="scene-kicker">10 // TU HUELLA ETERNA</span>
        <h2 class="scene-title">{t.searchTitle}</h2>
        <p class="beat-text">
          {locale === 'es'
            ? 'Si π es un número normal, dentro de su secuencia infinita están codificadas todas las fechas de nacimiento, todos los números de teléfono de tu infancia y las historias de amor que han existido. Todo ya estaba esperando en el tejido de π antes de que existieran las estrellas.'
            : 'If π is normal, within its infinite stream lies inscribed every birthday, every phone number from childhood, and every love story ever told. All was already waiting in the fabric of π before the first star was born.'}
        </p>
      </div>

      <div class="beat beat-closing" data-beat="0.78-0.98">
        <div class="closing-card blueprint-panel choreo-metrics">
          <blockquote class="closing-quote">
            «No había opción salvo medir lo inconmensurable. El círculo nunca se cierra; solo aumenta nuestra resolución.»
          </blockquote>

          <!-- Final Whispered Cosmic Reveal -->
          <div class="final-infinite-thanks">
            <span class="thanks-line">« Gracias por medir el infinito. »</span>
          </div>

          <div class="closing-author">— pi-tribute.dev</div>
          <p class="closing-sub">
            {locale === 'es' 
              ? 'De medir cuerdas en la arena de Egipto a estrellar supercomputadoras contra el infinito. El círculo sigue abierto.'
              : 'From measuring ropes in Egyptian sand to hurtling supercomputers against infinity. The circle remains open.'}
          </p>
          <div class="closing-actions">
            <a href="#scene-1" class="btn-restart">
              <span>↑</span> {locale === 'es' ? 'Volver al principio' : 'Return to beginning'}
            </a>
          </div>
          <footer class="closing-credits">
            <span>{t.credits}</span>
          </footer>
        </div>
      </div>
    </div>

    <!-- Right Column: The 1-Million Digits Scientific Search Rig -->
    <div class="search-rig choreo-artifact" id="search-rig">
      <div class="search-box blueprint-panel">
        <div class="search-input-wrap">
          <input 
            type="text" 
            id="pi-search-input" 
            placeholder="Ej: 14031992 o cualquier secuencia"
            maxlength="16"
            autocomplete="off"
            class="pi-input tabular"
          />
          <button type="button" id="pi-search-btn" class="pi-btn">
            {locale === 'es' ? 'BUSCAR EN π' : 'SEARCH IN π'}
          </button>
        </div>

        <!-- Result Card (Technical Terminal Output) -->
        <div class="search-result" id="search-result" style="display: none;">
          <div class="result-status" id="result-status"></div>
          <div class="result-snippet" id="result-snippet"></div>
        </div>

        <div class="search-hint">
          <span class="tabular">{locale === 'es' ? 'Dataset cargado: 1,000,000 de dígitos reales de π' : 'Dataset loaded: 1,000,000 actual digits of π'}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { soundEngine } from '../../scripts/audio';

  const input = document.getElementById('pi-search-input') as HTMLInputElement | null;
  const btn = document.getElementById('pi-search-btn');
  const resultBox = document.getElementById('search-result');
  const resultStatus = document.getElementById('result-status');
  const resultSnippet = document.getElementById('result-snippet');

  let piDigits: string | null = null;
  let isLoading = false;

  async function loadDigits() {
    if (piDigits || isLoading) return;
    isLoading = true;
    try {
      const res = await fetch('/digits/pi-1m.txt');
      const text = await res.text();
      piDigits = text.replace(/[^0-9]/g, '');
    } catch (e) {
      console.error('Failed to load pi digits:', e);
    } finally {
      isLoading = false;
    }
  }

  input?.addEventListener('focus', loadDigits);
  window.addEventListener('pi-scene-change', (e: any) => {
    if (e.detail?.sceneId === 'infinity' || e.detail?.sceneNumber >= 8) {
      loadDigits();
    }
  });

  function performSearch() {
    if (!input || !resultBox || !resultStatus || !resultSnippet) return;
    const query = input.value.replace(/[^0-9]/g, '');

    if (!query || query.length < 2) {
      resultBox.style.display = 'block';
      resultStatus.innerHTML = '<span class="status-warn">Por favor ingresa al menos 2 números.</span>';
      resultSnippet.innerHTML = '';
      return;
    }

    if (!piDigits) {
      resultBox.style.display = 'block';
      resultStatus.innerHTML = '<span class="status-loading">Cargando 1M de dígitos...</span>';
      loadDigits().then(() => performSearch());
      return;
    }

    const idx = piDigits.indexOf(query);
    resultBox.style.display = 'block';

    if (idx !== -1) {
      soundEngine.playEniacHum();
      const start = Math.max(0, idx - 6);
      const end = Math.min(piDigits.length, idx + query.length + 6);
      const before = piDigits.substring(start, idx);
      const match = piDigits.substring(idx, idx + query.length);
      const after = piDigits.substring(idx + query.length, end);

      resultStatus.innerHTML = `
        <span class="status-success">
          ✓ ¡Encontrado en la posición <strong>${idx.toLocaleString()}</strong> de los decimales de π!
        </span>
      `;

      resultSnippet.innerHTML = `
        <div class="snippet-box tabular">
          <span class="snip-dim">...${before}</span>
          <span class="snip-match">${match}</span>
          <span class="snip-dim">${after}...</span>
        </div>
      `;
    } else {
      resultStatus.innerHTML = `
        <span class="status-not-found">
          ✗ No apareció en el primer millón de dígitos. (Prueba con una secuencia más corta).
        </span>
      `;
      resultSnippet.innerHTML = '';
    }
  }

  btn?.addEventListener('click', performSearch);
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') performSearch();
  });
</script>

<style>
  .scene {
    height: 380vh;
    position: relative;
    --p: 0;
  }

  #scene-10-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    background: var(--bg-surface) !important;
    color: var(--fg-ink) !important;
  }

  .cosmos-starfield-fade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background: radial-gradient(circle at 50% 50%, #080c18 0%, #020306 100%);
    opacity: clamp(0, calc((var(--p, 0) - 0.72) * 4), 0.96);
    transition: opacity 0.4s ease;
  }

  .library-narrative-col {
    position: relative;
    width: 100%;
    max-width: 540px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 5;
  }

  .final-infinite-thanks {
    margin: 18px 0;
    text-align: center;
  }

  .thanks-line {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 2.1rem);
    font-style: italic;
    color: #ffd700;
    text-shadow: 0 0 20px rgba(255, 215, 0, 0.7), 0 0 40px rgba(255, 215, 0, 0.3);
    display: inline-block;
    letter-spacing: 0.04em;
  }

  .beat {
    opacity: 0;
    transform: translate3d(0, 14px, 0);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    width: 100% !important;
  }

  .beat.is-active {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    pointer-events: auto;
    position: relative;
  }

  .scene-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--accent);
    display: inline-block;
    margin-bottom: 6px;
  }

  .scene-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.8vw, 2.8rem);
    font-weight: 400;
    font-style: italic;
    color: var(--fg-ink);
    margin: 0 0 10px;
  }

  .beat-text {
    font-family: var(--font-editorial);
    font-size: clamp(0.95rem, 1.8vw, 1.12rem);
    color: color-mix(in srgb, var(--fg-ink) 85%, transparent);
    line-height: 1.65;
    margin: 0;
  }

  /* Search Rig Architecture */
  .search-rig {
    position: relative;
    margin-top: 4px;
    width: 100%;
    max-width: 680px;
    z-index: 6;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .search-box {
    width: 100%;
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-radius: 0;
  }

  .search-input-wrap {
    display: flex;
    gap: 0;
    border: 1px solid var(--grid-line);
  }

  .pi-input {
    flex: 1;
    background: color-mix(in srgb, var(--bg-surface) 96%, black 4%);
    border: none;
    border-radius: 0;
    padding: 12px 16px;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--fg-ink);
    outline: none;
  }

  .pi-input:focus {
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .pi-btn {
    background: var(--accent);
    border: none;
    border-radius: 0;
    padding: 12px 22px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #fff;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .pi-btn:hover {
    opacity: 0.9;
  }

  .search-result {
    padding: 12px 16px;
    background: color-mix(in srgb, var(--bg-surface) 95%, black 5%);
    border: 1px solid var(--grid-line);
    border-radius: 0;
  }

  .result-status {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    margin-bottom: 6px;
  }

  :global(.status-success) {
    color: var(--accent);
    font-weight: 700;
  }
  :global(.status-warn) {
    color: #d97706;
  }
  :global(.status-not-found) {
    color: #dc2626;
  }
  :global(.status-loading) {
    color: var(--accent);
  }

  :global(.snippet-box) {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    padding: 8px;
    background: color-mix(in srgb, var(--bg-surface) 92%, black 8%);
    border: 1px solid var(--grid-line);
    border-radius: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4px;
  }

  :global(.snip-dim) {
    color: var(--muted);
  }

  :global(.snip-match) {
    color: #fff;
    background: var(--accent);
    font-weight: 700;
    padding: 2px 6px;
  }

  .search-hint {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
    text-align: center;
    letter-spacing: 0.06em;
  }

  /* Closing card */
  .closing-card {
    padding: 28px 24px;
    border-radius: 0;
    text-align: center;
  }

  .closing-quote {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.8vw, 1.8rem);
    font-style: italic;
    color: var(--accent);
    line-height: 1.4;
    margin: 0 0 12px;
  }

  .closing-author {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .closing-sub {
    font-family: var(--font-editorial);
    font-size: 1.05rem;
    color: var(--fg-ink);
    margin: 0 0 20px;
    line-height: 1.5;
  }

  .closing-actions {
    margin-bottom: 20px;
  }

  .btn-restart {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    border-radius: 0;
    transition: opacity 0.15s ease;
  }

  .btn-restart:hover {
    opacity: 0.9;
  }

  .closing-credits {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }
</style>
