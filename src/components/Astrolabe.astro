---
// Astrolabe.astro - Astronomical graduated circular dial replacing generic scrollbar
---

<div class="astrolabe-widget" id="astrolabe-widget" role="progressbar" aria-label="Astrolabio de progreso angular en radianes">
  <div class="astrolabe-dial" id="astrolabe-dial">
    <svg viewBox="0 0 120 120" class="astrolabe-svg">
      <defs>
        <!-- Gradients adapted to historical era pigments -->
        <radialGradient id="astrolabe-metal" cx="50%" cy="50%" r="50%">
          <stop offset="60%" stop-color="var(--astrolabe-bg, #1a1510)" />
          <stop offset="100%" stop-color="var(--astrolabe-rim, #2c2219)" />
        </radialGradient>
      </defs>

      <!-- Outer calibrated graduation ring -->
      <circle cx="60" cy="60" r="54" fill="url(#astrolabe-metal)" stroke="var(--accent)" stroke-width="1.8" class="outer-rim" />
      
      <!-- Graduation ticks every 30 deg (π/6) and 90 deg (π/2) -->
      {Array.from({ length: 12 }).map((_, i) => {
        const deg = i * 30;
        const isMajor = i % 3 === 0;
        return (
          <line 
            x1="60" 
            y1={isMajor ? "10" : "14"} 
            x2="60" 
            y2="20" 
            stroke="var(--accent)" 
            stroke-width={isMajor ? "1.8" : "0.8"} 
            opacity={isMajor ? "0.9" : "0.4"} 
            transform={`rotate(${deg} 60 60)`} 
          />
        );
      })}

      <!-- Rotating Cursor Pointer Needle -->
      <g id="astrolabe-needle" class="needle-group">
        <line x1="60" y1="60" x2="60" y2="14" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" />
        <circle cx="60" cy="14" r="3" fill="var(--accent)" />
        <circle cx="60" cy="60" r="4.5" fill="var(--accent)" />
      </g>
    </svg>
  </div>

  <!-- Center Radians Metric Readout -->
  <div class="astrolabe-readout">
    <span class="rad-val" id="astrolabe-rad-text">0.00π</span>
    <span class="rad-label">RAD</span>
  </div>
</div>

<script>
  const widget = document.getElementById('astrolabe-widget');
  const dial = document.getElementById('astrolabe-dial');
  const radText = document.getElementById('astrolabe-rad-text');

  function updateAstrolabe() {
    const scrollY = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? Math.min(1, Math.max(0, scrollY / docHeight)) : 0;

    // 0 -> 1 progress maps to 0 -> 2π radians (0 -> 360 deg)
    const angleDeg = progress * 360;
    const radFactor = (progress * 2).toFixed(2);

    if (dial) {
      dial.style.transform = `rotate(${angleDeg}deg)`;
    }
    if (radText) {
      radText.textContent = `${radFactor}π`;
    }
  }

  window.addEventListener('scroll', updateAstrolabe, { passive: true });
  updateAstrolabe();

  // Clicking astrolabe smoothly returns to top if at bottom, or jumps
  widget?.addEventListener('click', () => {
    if (window.scrollY > 500) {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });
</script>

<style>
  .astrolabe-widget {
    position: fixed;
    bottom: 24px;
    right: 28px;
    width: 84px;
    height: 84px;
    z-index: 1000;
    cursor: pointer;
    user-select: none;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    --astrolabe-bg: #16120e;
    --astrolabe-rim: #281f18;
  }

  :global([data-theme="infinite"]) .astrolabe-widget,
  :global([data-theme="infinity"]) .astrolabe-widget {
    --astrolabe-bg: #ece7db;
    --astrolabe-rim: #ded7c6;
  }

  :global([data-theme="stone"]) .astrolabe-widget,
  :global([data-theme="leiden"]) .astrolabe-widget,
  :global([data-theme="paris"]) .astrolabe-widget {
    --astrolabe-bg: #161816;
    --astrolabe-rim: #252825;
  }

  :global([data-theme="eniac"]) .astrolabe-widget {
    --astrolabe-bg: #0d1611;
    --astrolabe-rim: #18281f;
  }

  .astrolabe-widget:hover {
    transform: scale(1.08);
  }

  .astrolabe-dial {
    width: 100%;
    height: 100%;
    will-change: transform;
    transition: transform 0.1s linear;
  }

  .astrolabe-svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 4px 15px rgba(0, 0, 0, 0.5));
  }

  .needle-group {
    transform-origin: 60px 60px;
  }

  .astrolabe-readout {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    line-height: 1;
  }

  .rad-val {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--fg-ink);
    font-variant-numeric: tabular-nums slashed-zero;
    letter-spacing: -0.02em;
  }

  .rad-label {
    font-family: var(--font-mono);
    font-size: 0.52rem;
    color: var(--accent);
    letter-spacing: 0.12em;
    margin-top: 2px;
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .astrolabe-widget {
      bottom: 16px;
      right: 16px;
      width: 70px;
      height: 70px;
    }
  }
</style>
