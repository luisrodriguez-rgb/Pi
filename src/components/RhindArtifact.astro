---
// RhindArtifact.astro - Authentic SVG Vector Reconstruction of Problem 48
---

<div class="rhind-artifact-frame">
  <svg viewBox="0 0 400 400" class="artifact-svg rhind-svg" aria-label="Papiro de Rhind Problema 48">
    <defs>
      <!-- Filtro de tinta antigua corrida sobre fibra de papiro -->
      <filter id="ancient-ink" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="4" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="3.5" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <!-- Patrón de fibras verticales y horizontales de papiro -->
      <pattern id="papyrus-weave" width="8" height="8" patternUnits="userSpaceOnUse">
        <path d="M 0 4 L 8 4 M 4 0 L 4 8" stroke="#8C6D46" stroke-width="0.4" stroke-opacity="0.25" />
      </pattern>
    </defs>

    <!-- Placa base del fragmento de papiro -->
    <rect x="20" y="20" width="360" height="360" fill="#1A140E" stroke="#8C6D46" stroke-width="1" />
    <rect x="20" y="20" width="360" height="360" fill="url(#papyrus-weave)" />

    <!-- Cuadrícula egipcia de 9x9 (dividida en tercios de 3x3) -->
    <g stroke="#E6D7B9" stroke-opacity="0.22" stroke-width="1" filter="url(#ancient-ink)">
      <rect x="65" y="65" width="270" height="270" fill="none" stroke-opacity="0.5" stroke-width="1.8" />
      <!-- Tercios principales (90px cada 3 unidades) -->
      <line x1="155" y1="65" x2="155" y2="335" />
      <line x1="245" y1="65" x2="245" y2="335" />
      <line x1="65" y1="155" x2="335" y2="155" />
      <line x1="65" y1="245" x2="335" y2="245" />
    </g>

    <!-- Octágono irregular de Ahmes trazado con cálamo grueso -->
    <polygon 
      points="155,65 245,65 335,155 335,245 245,335 155,335 65,245 65,155" 
      fill="#D94E28" 
      fill-opacity="0.08"
      stroke="#E6D7B9" 
      stroke-width="3.5" 
      filter="url(#ancient-ink)"
    />

    <!-- Círculo sagrado en pigmento Cinabrio Rojo (animable con --p) -->
    <circle 
      cx="200" cy="200" r="135" 
      fill="none" 
      stroke="#D94E28" 
      stroke-width="2.5"
      class="rhind-circle"
      filter="url(#ancient-ink)"
    />

    <!-- Notación hierática egipcia (números 9 en los bordes) -->
    <text x="195" y="52" fill="#D94E28" font-family="serif" font-size="16" filter="url(#ancient-ink)">𓏺𓏺𓏺 9 khet</text>
    <text x="180" y="205" fill="#E6D7B9" font-family="'B612 Mono', monospace" font-size="11" opacity="0.8">A ≈ (8/9 d)² = 64/81 d²</text>
  </svg>
</div>

<style>
  .rhind-artifact-frame {
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
    position: relative;
    border: 1px solid var(--grid-line);
    background: color-mix(in srgb, var(--bg-surface) 94%, transparent);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7);
  }

  .artifact-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .rhind-circle {
    stroke-dasharray: 848;
    stroke-dashoffset: calc(848 * (1 - clamp(0, var(--p, 0) * 1.8, 1)));
    transition: stroke-dashoffset 0.08s linear;
  }
</style>
