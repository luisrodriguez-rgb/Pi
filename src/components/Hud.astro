---
import { UI_STRINGS, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const t = UI_STRINGS[locale];
---

<header class="hud-container" role="banner" aria-label="HUD de navegación histórica">
  <!-- Top global progress line (GPU accelerated scaleX) -->
  <div class="hud-progress-track">
    <div id="hud-progress-bar" class="hud-progress-fill"></div>
  </div>

  <div class="hud-bar">
    <!-- Left: Era & Milestone -->
    <div class="hud-section hud-left">
      <a href="#scene-1" class="hud-brand" aria-label="Volver al inicio">
        <span class="hud-pi-symbol">π</span>
        <span class="hud-brand-text">pi-tribute</span>
      </a>
      <div class="hud-divider"></div>
      <div class="hud-meta-block">
        <span class="hud-label">{t.hudEra}</span>
        <span id="hud-year" class="hud-value hud-glow">2000 a.C.</span>
      </div>
    </div>

    <!-- Center: Precision reached in this era -->
    <div class="hud-section hud-center">
      <div class="hud-meta-block">
        <span class="hud-label">{t.hudPrecision}</span>
        <span id="hud-pi" class="hud-value hud-mono-value">3.14159...</span>
      </div>
    </div>

    <!-- Right: Scene indicator, Audio toggle, Language -->
    <div class="hud-section hud-right">
      <div class="hud-scene-counter">
        <span class="hud-label">{t.hudScene}</span>
        <span class="hud-counter-box">
          <strong id="hud-scene-num">01</strong>
          <span class="hud-dim">/</span>
          <span class="hud-dim">10</span>
        </span>
      </div>

      <!-- Audio Synth Toggle -->
      <button 
        id="audio-toggle-btn" 
        class="hud-btn" 
        type="button" 
        title={t.soundOff}
        aria-label="Alternar síntesis de sonido"
      >
        <span class="audio-waves">
          <span class="bar bar-1"></span>
          <span class="bar bar-2"></span>
          <span class="bar bar-3"></span>
        </span>
        <span id="audio-btn-label" class="hud-btn-text">Audio</span>
      </button>

      <!-- Language selector -->
      <div class="lang-switch">
        <a href="/" class={locale === 'es' ? 'lang-link active' : 'lang-link'}>ES</a>
        <span class="lang-sep">|</span>
        <a href="/en" class={locale === 'en' ? 'lang-link active' : 'lang-link'}>EN</a>
      </div>
    </div>
  </div>
</header>

<script>
  import { soundEngine } from '../scripts/audio';

  const audioBtn = document.getElementById('audio-toggle-btn');
  const audioBtnLabel = document.getElementById('audio-btn-label');

  function updateAudioUI(enabled: boolean) {
    if (!audioBtn) return;
    if (enabled) {
      audioBtn.classList.add('is-playing');
      if (audioBtnLabel) audioBtnLabel.textContent = 'ON';
      audioBtn.setAttribute('aria-pressed', 'true');
    } else {
      audioBtn.classList.remove('is-playing');
      if (audioBtnLabel) audioBtnLabel.textContent = 'OFF';
      audioBtn.setAttribute('aria-pressed', 'false');
    }
  }

  if (audioBtn) {
    audioBtn.addEventListener('click', () => {
      const enabled = soundEngine.toggle();
      updateAudioUI(enabled);
    });

    window.addEventListener('pi-audio-state-changed', (e: any) => {
      updateAudioUI(Boolean(e.detail?.enabled));
    });

    updateAudioUI(soundEngine.getState());
  }
</script>

<style>
  .hud-container {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    pointer-events: none;
  }

  .hud-progress-track {
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.05);
    position: relative;
    overflow: hidden;
  }

  .hud-progress-fill {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #d4af37, #00ffcc, #ffd700);
    transform-origin: left center;
    transform: scaleX(0);
    will-change: transform;
    box-shadow: 0 0 10px rgba(0, 255, 204, 0.5);
  }

  .hud-bar {
    pointer-events: auto;
    margin: 12px 20px;
    padding: 10px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(13, 15, 20, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    transition: border-color 0.3s ease;
  }

  .hud-bar:hover {
    border-color: rgba(212, 175, 55, 0.25);
  }

  .hud-section {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hud-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #fff;
    font-weight: 600;
  }

  .hud-pi-symbol {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    color: #ffd000;
    line-height: 1;
    text-shadow: 0 0 12px rgba(255, 208, 0, 0.6);
  }

  .hud-brand-text {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.85);
  }

  .hud-divider {
    width: 1px;
    height: 20px;
    background: rgba(255, 255, 255, 0.12);
  }

  .hud-meta-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hud-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.45);
  }

  .hud-value {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    color: #f0f3f6;
  }

  .hud-glow {
    color: #ffd700;
    text-shadow: 0 0 8px rgba(255, 215, 0, 0.3);
  }

  .hud-mono-value {
    font-family: var(--font-mono);
    color: #00ffcc;
    text-shadow: 0 0 8px rgba(0, 255, 204, 0.3);
    letter-spacing: 0.04em;
  }

  .hud-counter-box {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: #fff;
    display: flex;
    align-items: baseline;
    gap: 2px;
  }

  .hud-dim {
    color: rgba(255, 255, 255, 0.35);
  }

  .hud-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 6px 12px;
    color: rgba(255, 255, 255, 0.8);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .hud-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.25);
    color: #fff;
  }

  .hud-btn.is-playing {
    border-color: #00ffcc;
    color: #00ffcc;
    box-shadow: 0 0 10px rgba(0, 255, 204, 0.2);
  }

  .audio-waves {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }

  .audio-waves .bar {
    width: 2px;
    background: currentColor;
    border-radius: 1px;
    height: 4px;
    transition: height 0.2s ease;
  }

  .hud-btn.is-playing .bar-1 {
    animation: wave 0.8s ease-in-out infinite alternate;
  }
  .hud-btn.is-playing .bar-2 {
    animation: wave 0.8s ease-in-out 0.2s infinite alternate;
  }
  .hud-btn.is-playing .bar-3 {
    animation: wave 0.8s ease-in-out 0.4s infinite alternate;
  }

  @keyframes wave {
    0% { height: 3px; }
    100% { height: 12px; }
  }

  .lang-switch {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .lang-link {
    color: rgba(255, 255, 255, 0.4);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .lang-link:hover, .lang-link.active {
    color: #ffd000;
  }

  .lang-sep {
    color: rgba(255, 255, 255, 0.2);
  }

  @media (max-width: 768px) {
    .hud-bar {
      margin: 8px 10px;
      padding: 8px 12px;
    }
    .hud-brand-text, .hud-divider, .hud-center {
      display: none;
    }
  }
</style>
