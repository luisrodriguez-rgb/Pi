---
import { UI_STRINGS, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const t = UI_STRINGS[locale];
---

<header class="hud-container" role="banner" aria-label="Instrumento de navegación astronómica">
  <!-- Top global progress line (GPU accelerated scaleX) -->
  <div class="hud-progress-track">
    <div id="hud-progress-bar" class="hud-progress-fill"></div>
  </div>

  <div class="hud-bar">
    <!-- Left: Brand & Blueprint Trigger -->
    <div class="hud-section hud-left">
      <button 
        type="button" 
        id="hud-blueprint-toggle" 
        class="hud-brand-btn" 
        title="Modo Rayos X (Presiona Alt o Haz Clic)"
        aria-label="Alternar inspección matemática de rayos X"
      >
        <span class="hud-pi-symbol">π</span>
        <span class="hud-brand-text">pi-tribute</span>
      </button>

      <div class="hud-blueprint-badge" id="blueprint-badge" style="display: none;">
        <span>X-RAY // 0 REPAINTS · GPU COMPOSITED</span>
      </div>

      <div class="hud-divider"></div>

      <!-- Era & Location Catalog Plate -->
      <div class="hud-meta-block">
        <span class="hud-label">ÉPOCA // LUGAR</span>
        <span id="hud-year" class="hud-value tabular">1650 a.C. · Tebas</span>
      </div>
    </div>

    <!-- Center: Precision reached in this era (Strictly tabular nums) -->
    <div class="hud-section hud-center">
      <div class="hud-meta-block">
        <span class="hud-label">{locale === 'es' ? 'PRECISIÓN HISTÓRICA [π]' : 'HISTORICAL PRECISION [π]'}</span>
        <span id="hud-pi" class="hud-value hud-mono-value tabular">3.16049...</span>
      </div>
    </div>

    <!-- Right: Scene indicator, Audio toggle, Language (Generous spacing & dial aesthetic) -->
    <div class="hud-section hud-right">
      <div class="hud-scene-counter" title={locale === 'es' ? 'Capítulo actual del homenaje' : 'Current chapter'}>
        <span class="hud-label">{locale === 'es' ? 'CAPÍTULO' : 'CHAPTER'}</span>
        <span class="hud-counter-box tabular">
          <strong id="hud-scene-num">01</strong>
          <span class="hud-dim">/</span>
          <span class="hud-dim">10</span>
        </span>
      </div>

      <div class="hud-divider"></div>

      <!-- Audio Synth Toggle -->
      <button 
        id="audio-toggle-btn" 
        class="hud-btn" 
        type="button" 
        title={t.soundOff}
        aria-label="Alternar síntesis de sonido"
      >
        <span class="audio-waves">
          <span class="bar bar-1"></span>
          <span class="bar bar-2"></span>
          <span class="bar bar-3"></span>
        </span>
        <span id="audio-btn-label" class="hud-btn-text tabular">SONIDO</span>
      </button>

      <div class="hud-divider"></div>

      <!-- Language selector -->
      <nav class="lang-switch tabular" aria-label={locale === 'es' ? 'Selector de idioma' : 'Language switcher'}>
        <a 
          href="/" 
          class={locale === 'es' ? 'lang-link active' : 'lang-link'}
          aria-label="Ver versión en español"
          hreflang="es"
        >ES</a>
        <span class="lang-sep" aria-hidden="true">/</span>
        <a 
          href="/en/" 
          class={locale === 'en' ? 'lang-link active' : 'lang-link'}
          aria-label="View English version"
          hreflang="en"
        >EN</a>
      </nav>
    </div>
  </div>
</header>

<script>
  import { soundEngine } from '../scripts/audio';

  const audioBtn = document.getElementById('audio-toggle-btn');
  const audioBtnLabel = document.getElementById('audio-btn-label');
  const blueprintBtn = document.getElementById('hud-blueprint-toggle');
  const blueprintBadge = document.getElementById('blueprint-badge');

  function updateAudioUI(enabled: boolean) {
    if (!audioBtn) return;
    if (enabled) {
      audioBtn.classList.add('is-playing');
      if (audioBtnLabel) audioBtnLabel.textContent = 'ON';
      audioBtn.setAttribute('aria-pressed', 'true');
    } else {
      audioBtn.classList.remove('is-playing');
      if (audioBtnLabel) audioBtnLabel.textContent = 'OFF';
      audioBtn.setAttribute('aria-pressed', 'false');
    }
  }

  if (audioBtn) {
    audioBtn.addEventListener('click', () => {
      const enabled = soundEngine.toggle();
      updateAudioUI(enabled);
    });

    window.addEventListener('pi-audio-state-changed', (e: any) => {
      updateAudioUI(Boolean(e.detail?.enabled));
    });

    updateAudioUI(soundEngine.getState());
  }

  // ==========================================================
  // X-Ray Blueprint Mode Toggle (Click [π] or Hold Alt Key)
  // ==========================================================
  function toggleBlueprint() {
    const isBp = document.body.classList.toggle('is-blueprint');
    if (blueprintBadge) {
      blueprintBadge.style.display = isBp ? 'inline-flex' : 'none';
    }
  }

  blueprintBtn?.addEventListener('click', toggleBlueprint);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Alt') {
      document.body.classList.add('is-blueprint');
      if (blueprintBadge) blueprintBadge.style.display = 'inline-flex';
    }
  });

  window.addEventListener('keyup', (e) => {
    if (e.key === 'Alt') {
      document.body.classList.remove('is-blueprint');
      if (blueprintBadge) blueprintBadge.style.display = 'none';
    }
  });
</script>

<style>
  .hud-container {
    position: fixed;
    top: 0;
    left: 24px;
    right: 0;
    z-index: 1000;
    pointer-events: none;
  }

  .hud-progress-track {
    width: 100%;
    height: 2px;
    background: var(--grid-line);
    position: relative;
    overflow: hidden;
  }

  .hud-progress-fill {
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform-origin: left center;
    transform: scaleX(0);
    will-change: transform;
    box-shadow: 0 0 10px var(--glow-accent);
  }

  /* Architectural Instrument HUD Bar (Zero SaaS template shadows) */
  .hud-bar {
    pointer-events: auto;
    margin: 8px 18px 0;
    padding: 8px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: color-mix(in srgb, var(--bg-surface) 90%, transparent);
    border: 1px solid var(--grid-line);
    backdrop-filter: blur(8px);
    transition: all 0.3s ease;
  }

  .hud-section {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hud-brand-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    color: var(--fg-ink);
    cursor: pointer;
    padding: 2px 4px;
  }

  .hud-pi-symbol {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--accent);
    line-height: 1;
    text-shadow: 0 0 12px var(--glow-accent);
  }

  .hud-brand-text {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--fg-ink);
    text-transform: uppercase;
  }

  .hud-blueprint-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: #39ff88;
    background: rgba(57, 255, 136, 0.15);
    border: 1px solid #39ff88;
    padding: 2px 8px;
    letter-spacing: 0.08em;
  }

  .hud-divider {
    width: 1px;
    height: 22px;
    background: var(--grid-line);
  }

  .hud-meta-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hud-label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .hud-value {
    font-family: var(--font-editorial);
    font-size: 0.95rem;
    color: var(--fg-ink);
  }

  .hud-mono-value {
    font-family: var(--font-mono) !important;
    font-size: 0.9rem;
    color: var(--accent);
    font-variant-numeric: tabular-nums slashed-zero;
    letter-spacing: 0.02em;
  }

  .hud-right {
    gap: 16px;
  }

  .hud-scene-counter {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border: 1px solid var(--grid-line);
    background: color-mix(in srgb, var(--bg-surface) 95%, transparent);
  }

  .hud-counter-box {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--fg-ink);
    font-variant-numeric: tabular-nums slashed-zero;
  }

  .hud-dim {
    color: var(--muted);
  }

  .hud-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: 1px solid var(--grid-line);
    padding: 5px 12px;
    color: var(--fg-ink);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .hud-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .hud-btn.is-playing {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 0 10px var(--glow-accent);
  }

  .audio-waves {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }

  .audio-waves .bar {
    width: 2px;
    background: currentColor;
    height: 4px;
    transition: height 0.2s ease;
  }

  .hud-btn.is-playing .bar-1 {
    animation: wave 0.8s ease-in-out infinite alternate;
  }
  .hud-btn.is-playing .bar-2 {
    animation: wave 0.8s ease-in-out 0.2s infinite alternate;
  }
  .hud-btn.is-playing .bar-3 {
    animation: wave 0.8s ease-in-out 0.4s infinite alternate;
  }

  @keyframes wave {
    0% { height: 3px; }
    100% { height: 12px; }
  }

  .lang-switch {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .lang-link {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .lang-link:hover, .lang-link.active {
    color: var(--accent);
  }

  .lang-sep {
    color: var(--muted);
    opacity: 0.5;
  }

  @media (max-width: 820px) {
    .hud-container {
      left: 0;
    }
    .hud-bar {
      margin: 4px 8px 0;
      padding: 6px 10px;
    }
    .hud-brand-text, .hud-divider, .hud-center {
      display: none;
    }
  }
</style>
