---
// src/components/SceneVideo.astro - Cinematic Atmosphere Background Video Player
interface Props {
  src: string;
  poster?: string;
  blend?: 'normal' | 'lighten' | 'screen' | 'luminosity' | 'multiply';
  opacity?: number;
  focalPoint?: string;
}

const { 
  src, 
  poster,
  blend = 'lighten', 
  opacity = 0.48,
  focalPoint = 'center center'
} = Astro.props;
---

<div class="scene-video-rig" style={`--vid-opacity: ${opacity}; --vid-blend: ${blend}; --vid-pos: ${focalPoint};`}>
  <video
    class="scene-video"
    src={src}
    poster={poster}
    muted
    loop
    playsinline
    preload="metadata"
    data-scene-video
  ></video>
  <!-- Capa de fundido perimetral y protección de legibilidad de texto -->
  <div class="video-vignette"></div>
</div>

<style>
  .scene-video-rig {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .scene-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--vid-pos);
    mix-blend-mode: var(--vid-blend);
    /* La opacidad se modula sutilmente con --p */
    opacity: calc(var(--vid-opacity) * (0.7 + sin(var(--p, 0) * 3.14159) * 0.3));
    will-change: transform, opacity;
    /* Cámara virtual acoplada al scroll: zoom suave + ligero desplazamiento vertical */
    transform: 
      scale3d(calc(1.02 + var(--p, 0) * 0.08), calc(1.02 + var(--p, 0) * 0.08), 1)
      translate3d(0, calc((0.5 - var(--p, 0)) * 24px), 0);
    filter: contrast(1.12) saturate(0.92);
    transition: opacity 0.6s ease;
  }

  /* Funde el vídeo con el fondo de la escena arriba, abajo y en el centro del texto */
  .video-vignette {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 50% 55%, transparent 25%, var(--bg-surface) 92%),
      linear-gradient(
        to bottom,
        var(--bg-surface) 0%,
        transparent 16%,
        transparent 84%,
        var(--bg-surface) 100%
      );
  }

  /* En la Escena 10 (Blanco Alabastro), invertimos la lógica de fusión */
  :global([data-theme="infinite"]) .scene-video,
  :global([data-theme="infinity"]) .scene-video {
    filter: contrast(1.05) brightness(1.05);
  }

  /* Si el usuario activa el Modo Rayos X [Alt], atenuamos el vídeo al 8% para ver los wireframes */
  :global(body.is-blueprint) .scene-video {
    opacity: 0.08 !important;
    filter: grayscale(100%) contrast(200%);
  }
</style>
