---
// src/components/SceneVideo.astro - Cinematic Atmosphere Background Video Player
interface Props {
  src: string;
  poster?: string;
  blend?: 'normal' | 'lighten' | 'screen' | 'luminosity' | 'multiply';
  opacity?: number;
  focalPoint?: string;
}

const { 
  src, 
  poster,
  blend = 'lighten', 
  opacity = 0.48,
  focalPoint = 'center center'
} = Astro.props;
---

<div class="scene-video-rig" style={`--vid-opacity: ${opacity}; --vid-blend: ${blend}; --vid-pos: ${focalPoint};`}>
  <video
    class="scene-video"
    src={src}
    poster={poster}
    muted
    playsinline
    preload="auto"
    data-scene-video
  ></video>
  <div class="video-vignette"></div>
</div>

<style>
  .scene-video-rig {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .scene-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--vid-pos);
    mix-blend-mode: var(--vid-blend);
    opacity: var(--vid-opacity);
    will-change: transform, opacity;
    /* Acompaña el scrubbing con un ligero zoom cinematográfico de 1.0 a 1.08 */
    transform: scale3d(calc(1 + var(--p, 0) * 0.08), calc(1 + var(--p, 0) * 0.08), 1);
    filter: contrast(1.12) saturate(0.95);
  }

  .video-vignette {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 50% 55%, transparent 30%, var(--bg-surface) 95%),
      linear-gradient(
        to bottom,
        var(--bg-surface) 0%,
        transparent 15%,
        transparent 85%,
        var(--bg-surface) 100%
      );
  }

  /* En la Escena 10 (Blanco Alabastro), adaptamos brillo y contraste */
  :global([data-theme="infinite"]) .scene-video,
  :global([data-theme="infinity"]) .scene-video {
    filter: contrast(1.05) brightness(1.05);
  }

  /* Si el usuario activa el Modo Rayos X [Alt], atenuamos el vídeo al 8% para ver los wireframes */
  :global(body.is-blueprint) .scene-video {
    opacity: 0.08 !important;
    filter: grayscale(100%) contrast(200%);
  }
</style>
