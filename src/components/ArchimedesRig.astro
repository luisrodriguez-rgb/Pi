---
import { FORMULAS } from '../data/formulas';
const steps = FORMULAS.archimedes.steps;
---

<div class="archimedes-rig" id="archimedes-rig">
  <!-- Polygon Visualizer SVG -->
  <div class="svg-container">
    <svg viewBox="-260 -260 520 520" class="rig-svg" aria-label="Diagrama de polígonos de Arquímedes">
      <defs>
        <radialGradient id="circle-glow" cx="50%" cy="50%" r="50%">
          <stop offset="70%" stop-color="#ffd700" stop-opacity="0.04" />
          <stop offset="100%" stop-color="#ffd700" stop-opacity="0.18" />
        </radialGradient>
        <filter id="glow-filter" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="3" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      <!-- Center coordinate axes faint -->
      <line x1="-240" y1="0" x2="240" y2="0" stroke="rgba(255,255,255,0.08)" stroke-width="1" stroke-dasharray="3,3" />
      <line x1="0" y1="-240" x2="0" y2="240" stroke="rgba(255,255,255,0.08)" stroke-width="1" stroke-dasharray="3,3" />

      <!-- Circumscribed polygon (outer, amber) -->
      <polygon id="poly-circum" class="poly-circum" points="" filter="url(#glow-filter)" />

      <!-- The pure circle in between (gold) -->
      <circle cx="0" cy="0" r="180" class="core-circle" fill="url(#circle-glow)" />

      <!-- Inscribed polygon (inner, cyan) -->
      <polygon id="poly-inscribed" class="poly-inscribed" points="" filter="url(#glow-filter)" />

      <!-- Center pin mark -->
      <circle cx="0" cy="0" r="3" fill="#ffd700" />
    </svg>

    <div class="rig-overlay-info">
      <div class="sides-badge">
        <span class="badge-label">LADOS</span>
        <strong id="rig-sides" class="badge-val">n = 6</strong>
      </div>
    </div>
  </div>

  <!-- Realtime calculation panel -->
  <div class="math-panel">
    <div class="math-bound math-lower">
      <span class="bound-title">Polígono Inscrito (Límite Inferior)</span>
      <span class="bound-formula">n · sen(π/n)</span>
      <div class="bound-val-wrap">
        <strong id="rig-lower-val" class="bound-val">3.00000</strong>
        <span id="rig-lower-frac" class="bound-frac">≈ 3</span>
      </div>
    </div>

    <div class="math-trap">
      <div class="trap-inequality">
        <span id="trap-left">3.0000</span>
        <span class="trap-pi">&lt; π &lt;</span>
        <span id="trap-right">3.4641</span>
      </div>
      <div class="trap-gap">
        <span>Brecha de error:</span>
        <strong id="trap-error">0.46410</strong>
      </div>
    </div>

    <div class="math-bound math-upper">
      <span class="bound-title">Polígono Circunscrito (Límite Superior)</span>
      <span class="bound-formula">n · tan(π/n)</span>
      <div class="bound-val-wrap">
        <strong id="rig-upper-val" class="bound-val">3.46410</strong>
        <span id="rig-upper-frac" class="bound-frac">≈ 22/7</span>
      </div>
    </div>
  </div>
</div>

<script>
  import { soundEngine } from '../scripts/audio';

  const rig = document.getElementById('archimedes-rig');
  const polyInscribed = document.getElementById('poly-inscribed') as SVGPolygonElement | null;
  const polyCircum = document.getElementById('poly-circum') as SVGPolygonElement | null;
  const sidesEl = document.getElementById('rig-sides');
  const lowerValEl = document.getElementById('rig-lower-val');
  const lowerFracEl = document.getElementById('rig-lower-frac');
  const upperValEl = document.getElementById('rig-upper-val');
  const upperFracEl = document.getElementById('rig-upper-frac');
  const trapLeft = document.getElementById('trap-left');
  const trapRight = document.getElementById('trap-right');
  const trapError = document.getElementById('trap-error');

  const R = 180; // circle radius

  function calculatePolygonPoints(n: number, radius: number): string {
    const pts: string[] = [];
    const step = (Math.PI * 2) / n;
    // Align vertex to top
    for (let i = 0; i < n; i++) {
      const angle = i * step - Math.PI / 2;
      const x = (Math.cos(angle) * radius).toFixed(2);
      const y = (Math.sin(angle) * radius).toFixed(2);
      pts.push(`${x},${y}`);
    }
    return pts.join(' ');
  }

  const stepsData = [
    { n: 6, lowerFrac: 'Hexágono', upperFrac: 'Hexágono ext.' },
    { n: 12, lowerFrac: 'Dodecágono', upperFrac: 'Dodecágono ext.' },
    { n: 24, lowerFrac: '24-gono', upperFrac: '24-gono ext.' },
    { n: 48, lowerFrac: '48-gono', upperFrac: '48-gono ext.' },
    { n: 96, lowerFrac: '223/71 (3.1408)', upperFrac: '22/7 (3.1428)' }
  ];

  let currentSides = -1;

  function updateRig() {
    if (!rig) return;
    const scene = rig.closest('[data-scene]') as HTMLElement | null;
    if (!scene) return;

    const pVal = parseFloat(getComputedStyle(scene).getPropertyValue('--p')) || 0;
    const p = Math.min(1, Math.max(0, pVal));

    // Map p (0 -> 1) to step index 0..4
    const stepIndex = Math.min(4, Math.floor(p * 5));
    const step = stepsData[stepIndex];
    const n = step.n;

    if (currentSides !== n) {
      currentSides = n;
      soundEngine.playPolygonDoubling(n);

      // Inscribed radius = R
      // Circumscribed radius = R / cos(π/n)
      const rCircum = R / Math.cos(Math.PI / n);

      if (polyInscribed) {
        polyInscribed.setAttribute('points', calculatePolygonPoints(n, R));
      }
      if (polyCircum) {
        polyCircum.setAttribute('points', calculatePolygonPoints(n, rCircum));
      }

      const lower = n * Math.sin(Math.PI / n);
      const upper = n * Math.tan(Math.PI / n);
      const diff = upper - lower;

      if (sidesEl) sidesEl.textContent = `n = ${n}`;
      if (lowerValEl) lowerValEl.textContent = lower.toFixed(5);
      if (lowerFracEl) lowerFracEl.textContent = step.lowerFrac;
      if (upperValEl) upperValEl.textContent = upper.toFixed(5);
      if (upperFracEl) upperFracEl.textContent = step.upperFrac;
      if (trapLeft) trapLeft.textContent = lower.toFixed(4);
      if (trapRight) trapRight.textContent = upper.toFixed(4);
      if (trapError) trapError.textContent = diff.toFixed(5);
    }
  }

  window.addEventListener('scroll', updateRig, { passive: true });
  updateRig();
</script>

<style>
  .archimedes-rig {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    width: 100%;
    max-width: 840px;
    margin: 0 auto;
  }

  .svg-container {
    position: relative;
    width: min(75vw, 420px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }

  .rig-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .core-circle {
    stroke: #ffd700;
    stroke-width: 2px;
    stroke-dasharray: 4, 3;
    opacity: 0.9;
  }

  .poly-circum {
    fill: rgba(255, 140, 0, 0.04);
    stroke: #ff9d00;
    stroke-width: 1.8px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .poly-inscribed {
    fill: rgba(0, 255, 204, 0.05);
    stroke: #00ffcc;
    stroke-width: 1.8px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .rig-overlay-info {
    position: absolute;
    bottom: -8px;
    background: rgba(13, 15, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: 6px 16px;
    backdrop-filter: blur(8px);
  }

  .sides-badge {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .badge-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.1em;
  }

  .badge-val {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: #ffd700;
    text-shadow: 0 0 10px rgba(255, 215, 0, 0.4);
  }

  .math-panel {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 16px;
    width: 100%;
    background: rgba(18, 22, 30, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 20px 24px;
    backdrop-filter: blur(12px);
  }

  .math-bound {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .bound-title {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .bound-formula {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .bound-val-wrap {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 4px;
  }

  .bound-val {
    font-family: var(--font-mono);
    font-size: 1.3rem;
  }

  .math-lower .bound-val {
    color: #00ffcc;
    text-shadow: 0 0 10px rgba(0, 255, 204, 0.3);
  }

  .math-upper .bound-val {
    color: #ff9d00;
    text-shadow: 0 0 10px rgba(255, 157, 0, 0.3);
  }

  .bound-frac {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .math-trap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  .trap-inequality {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 600;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .trap-pi {
    color: #ffd700;
    text-shadow: 0 0 12px rgba(255, 215, 0, 0.5);
    font-size: 1.2rem;
  }

  .trap-gap {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.45);
  }

  .trap-gap strong {
    color: #fff;
  }

  @media (max-width: 768px) {
    .math-panel {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .math-trap {
      border: none;
      padding: 12px 0;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
  }
</style>
